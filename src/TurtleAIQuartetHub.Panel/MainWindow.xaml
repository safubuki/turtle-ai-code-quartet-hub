<Window x:Class="TurtleAIQuartetHub.Panel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TurtleAIQuartetHub.Panel.Models"
        xmlns:local="clr-namespace:TurtleAIQuartetHub.Panel"
        xmlns:views="clr-namespace:TurtleAIQuartetHub.Panel.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Turtle AI Code Quartet Hub"
        Width="650"
        Height="535"
        MinWidth="560"
        MinHeight="520"
        Background="#101211"
        Foreground="#EEF4EF"
        FontFamily="Segoe UI"
        FontSize="12"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="app.ico"
        PreviewMouseDown="Window_PreviewMouseDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34"
                        ResizeBorderThickness="0"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <local:SubtractConverter x:Key="SubtractConverter" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#101211" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171B19" />
    <!-- 完了時にカードの地だけへ乗せる、アプリ色調と調和する深めの青。ボタンや IDE / CLI の地には使わない。 -->
    <SolidColorBrush x:Key="AiDoneCardBrush" Color="#112D46" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#1D2420" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#2E3832" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEF4EF" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA59E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#45D483" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#123222" />
    <SolidColorBrush x:Key="VsCodeSelectedBackgroundBrush" Color="#102D3F" />
    <SolidColorBrush x:Key="VsCodeSelectedBorderBrush" Color="#168FD6" />
    <SolidColorBrush x:Key="VsCodeSelectedForegroundBrush" Color="#9EDAF5" />
    <SolidColorBrush x:Key="AntigravitySelectedBackgroundBrush" Color="#2A2136" />
    <LinearGradientBrush x:Key="AntigravitySelectedBorderBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#AA644B" Offset="0" />
      <GradientStop Color="#A1844C" Offset="0.18" />
      <GradientStop Color="#6E945A" Offset="0.38" />
      <GradientStop Color="#4A8C8A" Offset="0.58" />
      <GradientStop Color="#457AA2" Offset="0.78" />
      <GradientStop Color="#77649E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AntigravitySelectedForegroundBrush" Color="#D9CCE2" />
    <!-- 非ベースディスプレイの色。ベース（作業ベース）は AccentBrush の緑、単独移動先は番号順に青→紫→金。 -->
    <SolidColorBrush x:Key="DisplayAccent2Brush" Color="#4FB4E8" />
    <SolidColorBrush x:Key="DisplayAccent3Brush" Color="#B488E8" />
    <SolidColorBrush x:Key="DisplayAccent4Brush" Color="#E8C24F" />
    <Style TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="InlineTitleTextBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="EditorBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <Grid>
                <TextBlock x:Name="TitleDisplay"
                           Text="{Binding DisplayTitle}"
                           FontSize="{TemplateBinding FontSize}"
                           FontWeight="{TemplateBinding FontWeight}"
                           Foreground="{TemplateBinding Foreground}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="{TemplateBinding Padding}" />
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsReadOnly" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsReadOnly" Value="False">
                <Setter TargetName="TitleDisplay" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="EditorBorder" Property="Background" Value="#202823" />
                <Setter TargetName="EditorBorder" Property="BorderBrush" Value="#4C6B59" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="EditorBorder" Property="BorderBrush" Value="#3A453E" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Arrow" />
      <Setter Property="ToolTip">
        <Setter.Value>
          <ToolTip Content="{Binding PlacementTarget.DataContext.DisplayTitle, RelativeSource={RelativeSource Self}}">
            <ToolTip.ContentTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" MaxWidth="420"
                           TextWrapping="Wrap" TextTrimming="None" />
              </DataTemplate>
            </ToolTip.ContentTemplate>
          </ToolTip>
        </Setter.Value>
      </Setter>
      <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsReadOnly, RelativeSource={RelativeSource Self}}" />
      <Setter Property="ToolTipService.ShowDuration" Value="30000" />
      <EventSetter Event="PreviewKeyDown" Handler="InlineTitleTextBox_PreviewKeyDown" />
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="InlineTitleTextBox_PreviewMouseLeftButtonDown" />
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="InlineTitleTextBox_PreviewMouseLeftButtonUp" />
      <EventSetter Event="LostKeyboardFocus" Handler="InlineTitleTextBox_LostKeyboardFocus" />
    </Style>

    <Style x:Key="SystemMonitorProgressBarStyle" TargetType="ProgressBar">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Height" Value="7" />
      <Setter Property="Background" Value="#0C1210" />
      <Setter Property="BorderBrush" Value="#24332B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border x:Name="PART_Track"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3.5"
                    ClipToBounds="True">
              <Border x:Name="PART_Indicator"
                      HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="2.5" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#121816" />
      <Setter Property="BorderBrush" Value="#2E3832" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ヘルプ内の CLI ガイド。コマンドはボタンにせず、選択・コピー専用で表示する。 -->
    <Style x:Key="HelpCliCardStyle" TargetType="Border">
      <Setter Property="Margin" Value="0,10,0,0" />
      <Setter Property="Padding" Value="11" />
      <Setter Property="Background" Value="#111815" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="HelpSectionLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,9,0,4" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="HelpInstallMethodLabelStyle" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,5,0,3" />
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>

    <Style x:Key="HelpCommandTextBoxStyle" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="#0C1210" />
      <Setter Property="BorderBrush" Value="#2A3A31" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="ToolTip" Value="表示専用です。選択して Ctrl+C でコピーできます。" />
    </Style>

    <Style x:Key="HelpAutonomousCommandTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource HelpCommandTextBoxStyle}">
      <Setter Property="Background" Value="#181110" />
      <Setter Property="BorderBrush" Value="#5E3A32" />
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#202823" />
      <Setter Property="BorderBrush" Value="#3A453E" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <!-- Button の既定は Center。左寄せにしたいボタンだけ HorizontalContentAlignment で変える。 -->
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B352F" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#53645A" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#18201B" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SettingsPresetButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="#17201B" />
      <Setter Property="BorderBrush" Value="#344A3E" />
    </Style>

    <Style x:Key="SettingsOpenNetworkButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsPresetButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding VsCodeUseHttpProxy}" Value="False">
          <Setter Property="Foreground" Value="#E9FFF2" />
          <Setter Property="Background" Value="#263F31" />
          <Setter Property="BorderBrush" Value="#59D58E" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SettingsProxyNetworkButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsPresetButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding VsCodeUseHttpProxy}" Value="True">
          <Setter Property="Foreground" Value="#E9FFF2" />
          <Setter Property="Background" Value="#263F31" />
          <Setter Property="BorderBrush" Value="#59D58E" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LaunchButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="#06120C" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
      <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="MinWidth" Value="54" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="#17201B" />
      <Setter Property="BorderBrush" Value="#385345" />
    </Style>

    <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Background" Value="#1B221E" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- 標準表示フッターの「すべて閉じる」。高さは BarButton のまま、色はカードのクリア（SlotClearInfoButtonStyle）に合わせる。 -->
    <Style x:Key="DangerBarButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="Foreground" Value="#F2B7AF" />
      <Setter Property="Background" Value="#261816" />
      <Setter Property="BorderBrush" Value="#6A3832" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#FFE7E2" />
                <Setter TargetName="ButtonBorder" Property="Background" Value="#33201D" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#A65348" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="#FFE7E2" />
                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C1210" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6A3832" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ApplicationSelectorBaseButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTip" Value="{Binding ToolTip}" />
      <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
      <Setter Property="Background" Value="#17201B" />
      <Setter Property="BorderBrush" Value="#344A3E" />
    </Style>

    <Style x:Key="ApplicationSelectorButtonStyle" TargetType="Button" BasedOn="{StaticResource ApplicationSelectorBaseButtonStyle}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Foreground" Value="#E9FFF2" />
          <Setter Property="Background" Value="#263F31" />
          <Setter Property="BorderBrush" Value="#59D58E" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
          <Setter Property="Foreground" Value="#66716A" />
          <Setter Property="Background" Value="#121816" />
          <Setter Property="BorderBrush" Value="#27322C" />
          <Setter Property="FontWeight" Value="Normal" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="CliApplicationOptionTemplate" DataType="{x:Type models:SlotApplicationOption}">
      <Button Tag="{Binding}"
              Click="SlotApplicationSwitchButton_Click"
              ToolTip="{Binding ToolTip}"
              ToolTipService.ShowOnDisabled="True"
              Style="{StaticResource ApplicationSelectorButtonStyle}">
        <TextBlock Text="{Binding ShortName}"
                   TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" />
      </Button>
    </DataTemplate>

    <Style x:Key="ApplicationGroupBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="#121816" />
      <Setter Property="BorderBrush" Value="#2B3D34" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="6,8,6,4" />
    </Style>

    <Style x:Key="ApplicationGroupLabelStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A9B7B0" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="8,-6,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Done}">
          <Setter Property="Background" Value="{StaticResource AiDoneCardBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="AuxiliaryApplicationButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="MinWidth" Value="86" />
      <Setter Property="Width" Value="86" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="ToolTip" Value="{Binding ToolTip}" />
      <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
      <Setter Property="Background" Value="#0E2030" />
      <Setter Property="BorderBrush" Value="#2C6888" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="Compact">
          <Setter Property="MinWidth" Value="84" />
          <Setter Property="Width" Value="84" />
          <Setter Property="MinHeight" Value="23" />
          <Setter Property="Height" Value="23" />
          <Setter Property="FontSize" Value="11.5" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="VisibilityRestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="Foreground" Value="#1A1406" />
      <Setter Property="Background" Value="#F2CA57" />
      <Setter Property="BorderBrush" Value="#FFF0B5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="CompactBarActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SlotActionButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinWidth" Value="64" />
    </Style>

    <Style x:Key="StoredAssignButton" TargetType="Button" BasedOn="{StaticResource MiniButton}">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="FontSize" Value="10" />
    </Style>

    <Style x:Key="StoredDeleteButton" TargetType="Button" BasedOn="{StaticResource StoredAssignButton}">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#F2B7AF" />
      <Setter Property="Background" Value="#261816" />
      <Setter Property="BorderBrush" Value="#6A3832" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ToolTip" Value="この控えをクリア（フォルダは削除されません）" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasContent}" Value="False">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StoredRegisterFolderButton" TargetType="Button" BasedOn="{StaticResource StoredAssignButton}">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#DDEFE5" />
      <Setter Property="Background" Value="#17271E" />
      <Setter Property="BorderBrush" Value="#3B604A" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="ToolTip" Value="フォルダを選んでこの控えに登録（ローカルのみ）" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#F2FFF8" />
          <Setter Property="Background" Value="#203629" />
          <Setter Property="BorderBrush" Value="#6BE49B" />
        </Trigger>
        <DataTrigger Binding="{Binding HasContent}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SlotClearInfoButtonStyle" TargetType="Button" BasedOn="{StaticResource StoredAssignButton}">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#F2B7AF" />
      <Setter Property="Background" Value="#261816" />
      <Setter Property="BorderBrush" Value="#6A3832" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="ToolTip" Value="このパネル情報をクリア（フォルダは削除されません）" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#FFE7E2" />
          <Setter Property="Background" Value="#33201D" />
          <Setter Property="BorderBrush" Value="#A65348" />
        </Trigger>
        <DataTrigger Binding="{Binding HasPanelContent}" Value="False">
          <Setter Property="IsEnabled" Value="False" />
          <Setter Property="Opacity" Value="0.4" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SlotOpenFolderButtonStyle" TargetType="Button" BasedOn="{StaticResource StoredAssignButton}">
      <Setter Property="MinWidth" Value="28" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="#DDEFE5" />
      <Setter Property="Background" Value="#17271E" />
