        </DataTrigger>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Done}">
          <Setter Property="Background" Value="{StaticResource AiDoneCardBrush}" />
          <Setter Property="Effect" Value="{x:Null}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- AI の作業状態（AI ツールのフックからの明示的な通知だけで決まる。WindowSlot.AiActivity）。
         作業中: 非フォーカス時は 1px 枠と外側の光背がホタルの明滅のようにゆっくり（5.6 秒周期）緑へ明滅し、
                 標準・縮小の A〜D アイコン枠（AiBadgeWorkingRingStyle）も同期して明滅する。
                 フォーカス表示時は太いフォーカス枠を点滅させずに固定し、その外側のぼんやりした光と A〜D アイコン枠を明滅させる。
                 許可の確認中もこの緑のまま。
         完了: カードの枠と地を深みのあるブルーへ切り替え、A〜D アイコン（極小表示はカード自体）を少し濃いめの青で点灯する。
                 ボタンと IDE / CLI の枠の中は塗らない。フォーカス表示の切り替えで消える。 -->
    <Color x:Key="AiGlowColor">#45D483</Color>
    <Color x:Key="AiDoneGlowColor">#228BE0</Color>
    <SolidColorBrush x:Key="AiDoneBorderBrush" Color="#3EA3EC" />
    <SolidColorBrush x:Key="AiDoneGlowBrush" Color="{StaticResource AiDoneGlowColor}" />
    <SolidColorBrush x:Key="AiDoneBadgeBackgroundBrush" Color="#174F85" />
    <SolidColorBrush x:Key="AiDoneBadgeBorderBrush" Color="#68C1FF" />
    <SolidColorBrush x:Key="AiDoneBadgeForegroundBrush" Color="#F0F8FF" />
    <DropShadowEffect x:Key="AiDoneBadgeGlowEffect"
                      Color="#2E96F0"
                      BlurRadius="9"
                      ShadowDepth="0"
                      Opacity="0.88" />

    <!-- 枠の外側の光源。縁と同じ角丸の面塗りを Quality ブラーで外へ大きく拡散させ、手前のカードで内側を隠すことで境界線を見せない。
         フォーカス中は Margin を -2 へ広げて 2px フォーカス枠の外縁と揃え、固定されたフォーカス枠の外でも点滅がはっきり見えるようにする。 -->
    <Style x:Key="AiCardHaloStyle" TargetType="Border">
      <Setter Property="Margin" Value="-1" />
      <Setter Property="Background" Value="#67E7A4" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Effect">
        <Setter.Value>
          <BlurEffect Radius="15" RenderingBias="Quality" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFocused}" Value="True">
          <Setter Property="Margin" Value="-2" />
        </DataTrigger>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Working}">
          <Setter Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="AiCardHaloPulse">
              <Storyboard Timeline.DesiredFrameRate="30">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                               Duration="0:0:5.6"
                                               RepeatBehavior="Forever">
                  <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.08" />
                  <SplineDoubleKeyFrame KeyTime="0:0:0.7" KeySpline="0.3,0,0.7,1" Value="0.10" />
                  <SplineDoubleKeyFrame KeyTime="0:0:2.4" KeySpline="0.35,0.05,0.25,1" Value="0.82" />
                  <SplineDoubleKeyFrame KeyTime="0:0:2.8" KeySpline="0.4,0,0.6,1" Value="0.77" />
                  <SplineDoubleKeyFrame KeyTime="0:0:5.6" KeySpline="0.22,0.08,0.35,1" Value="0.08" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="AiCardHaloPulse" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Done}">
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="Background" Value="{StaticResource AiDoneGlowBrush}" />
          <Setter Property="Opacity" Value="0.74" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- カードと同じ 1px の枠。非フォーカス作業中と完了時だけ表示し、フォーカス作業中は枠を点滅させない。 -->
    <Style x:Key="AiCardPulseStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#8AF2B5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Working}">
          <Setter Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="AiCardEdgePulse">
              <Storyboard Timeline.DesiredFrameRate="30">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                               Duration="0:0:5.6"
                                               RepeatBehavior="Forever">
                  <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.18" />
                  <SplineDoubleKeyFrame KeyTime="0:0:0.7" KeySpline="0.3,0,0.7,1" Value="0.20" />
                  <SplineDoubleKeyFrame KeyTime="0:0:2.4" KeySpline="0.35,0.05,0.25,1" Value="0.90" />
                  <SplineDoubleKeyFrame KeyTime="0:0:2.8" KeySpline="0.4,0,0.6,1" Value="0.86" />
                  <SplineDoubleKeyFrame KeyTime="0:0:5.6" KeySpline="0.22,0.08,0.35,1" Value="0.18" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="AiCardEdgePulse" />
          </DataTrigger.ExitActions>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsFocused}" Value="True" />
            <Condition Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Working}" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Collapsed" />
        </MultiDataTrigger>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Done}">
          <Setter Property="Visibility" Value="Visible" />
          <Setter Property="BorderBrush" Value="{StaticResource AiDoneBorderBrush}" />
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- 標準・縮小表示の A〜D アイコン上に重ねる作業中の明滅リング。カードと同じ 5.6 秒のホタル点滅に揃える。 -->
    <Style x:Key="AiBadgeWorkingRingStyle" TargetType="Border">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#8AF2B5" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="{StaticResource AiGlowColor}"
                            BlurRadius="8"
                            ShadowDepth="0"
                            Opacity="0.88" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Working}">
          <Setter Property="Visibility" Value="Visible" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="AiBadgeWorkingRingPulse">
              <Storyboard Timeline.DesiredFrameRate="30">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity"
                                               Duration="0:0:5.6"
                                               RepeatBehavior="Forever">
                  <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.18" />
                  <SplineDoubleKeyFrame KeyTime="0:0:0.7" KeySpline="0.3,0,0.7,1" Value="0.20" />
                  <SplineDoubleKeyFrame KeyTime="0:0:2.4" KeySpline="0.35,0.05,0.25,1" Value="0.95" />
                  <SplineDoubleKeyFrame KeyTime="0:0:2.8" KeySpline="0.4,0,0.6,1" Value="0.90" />
                  <SplineDoubleKeyFrame KeyTime="0:0:5.6" KeySpline="0.22,0.08,0.35,1" Value="0.18" />
                </DoubleAnimationUsingKeyFrames>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="AiBadgeWorkingRingPulse" />
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CompactSlotButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="Padding" Value="5,2" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CompactFocusFrame"
                    Background="Transparent"
                    BorderBrush="{Binding FocusFrameBrush}"
                    BorderThickness="2"
                    CornerRadius="8">
              <Grid>
                <Border CornerRadius="8"
                        Style="{StaticResource AiCardHaloStyle}" />
                <Border x:Name="CompactButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}" />
                </Border>
                <Border CornerRadius="7"
                        Style="{StaticResource AiCardPulseStyle}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CompactButtonBorder" Property="Background" Value="#1A211D" />
                <Setter TargetName="CompactButtonBorder" Property="BorderBrush" Value="#3D4E45" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CompactButtonBorder" Property="Background" Value="#121715" />
              </Trigger>
              <!-- 控えカードを選んでいる間は配置先として光らせる（local:SlotAssignTarget.IsArmed は CompactBarPanel から継承）。 -->
              <Trigger Property="local:SlotAssignTarget.IsArmed" Value="True">
                <Setter TargetName="CompactButtonBorder" Property="Background" Value="#152C1F" />
                <Setter TargetName="CompactButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="local:SlotAssignTarget.IsArmed" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CompactButtonBorder" Property="Background" Value="#24402F" />
              </MultiTrigger>
              <DataTrigger Binding="{Binding IsFocused}" Value="True">
                <Setter TargetName="CompactButtonBorder" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#45D483"
                                      BlurRadius="9"
                                      ShadowDepth="0"
                                      Opacity="0.3" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
              <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Working}">
                <Setter TargetName="CompactButtonBorder" Property="Effect" Value="{x:Null}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Done}">
                <Setter TargetName="CompactButtonBorder" Property="Background" Value="{StaticResource AiDoneCardBrush}" />
                <Setter TargetName="CompactButtonBorder" Property="Effect" Value="{x:Null}" />
              </DataTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Missing}">
          <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
          <Setter Property="BorderBrush" Value="#505B55" />
        </DataTrigger>
        <DataTrigger Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Launching}">
