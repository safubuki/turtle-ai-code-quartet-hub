    <Border x:Name="LogOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="24">
      <Grid>
        <!-- ダイアログの最大高さをウィンドウの実クライアント高に追従させ、上下マージン分だけ
             縮めて常に画面内へ収める。これがないと、オーバーレイの親（RootLayoutGrid の Auto 行）が
             コンテンツに合わせて伸び、ダイアログがウィンドウ高（既定 535）を超えて下端のボタン行が
             切れていた。本文(*) が伸縮し、ボタン行(Auto) は常に下端に残る。 -->
        <Border MaxWidth="760"
                Margin="14"
                Padding="16"
                MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SubtractConverter}, ConverterParameter=44}"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
          <!-- ヘッダー(Auto) / ログ本文(*) / ボタン行(Auto) の 3 段。本文だけが伸縮し、
               ボタン行は常に下端に残る。ログが長くても本文側に縦スクロールが出るだけで、
               コピー等のボタンが画面外へ押し出されないようにする。 -->
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="本日のログ"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="LogFilePathText"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      ToolTip="閉じる"
                      AutomationProperties.Name="ログを閉じる"
                      Click="CloseLogButton_Click"
                      Style="{StaticResource ModalCloseButtonStyle}" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="2"
                    Background="#111815"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
              <TextBox x:Name="LogContentTextBox"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       BorderThickness="0"
                       Background="Transparent"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" />
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
              <Button Content="コピー"
                      Click="CopyLogButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="86"
                      Margin="0,0,8,0"
                      ToolTip="表示中の本日分ログをクリップボードへコピー" />
              <Button Content="再読み込み"
                      Click="ReloadLogButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="96"
                      Margin="0,0,8,0"
                      ToolTip="本日分を最新の内容で読み直し" />
              <Button Content="ファイルを開く"
                      Click="OpenLogFileButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="110"
                      Margin="0,0,8,0"
                      ToolTip="panel.log を既定アプリで開く（不可ならフォルダを開く）" />
              <Button Content="閉じる"
                      Click="CloseLogButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="86" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

