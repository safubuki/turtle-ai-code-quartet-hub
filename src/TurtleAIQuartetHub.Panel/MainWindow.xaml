    <DataTemplate x:Key="SlotCardTemplate" DataType="{x:Type models:WindowSlot}">
      <Border x:Name="SlotCardFocusFrame"
              Background="Transparent"
              BorderThickness="2"
              BorderBrush="{Binding FocusFrameBrush}"
              CornerRadius="10"
              Tag="{Binding}"
              Cursor="Hand"
              MouseLeftButtonUp="SlotCard_MouseLeftButtonUp"
              PreviewMouseLeftButtonDown="SlotCard_PreviewMouseLeftButtonDown"
              PreviewMouseMove="SlotCard_PreviewMouseMove"
              AllowDrop="True"
              DragEnter="SlotCard_DragEnter"
              DragLeave="SlotCard_DragLeave"
              DragOver="SlotCard_DragOver"
              Drop="SlotCard_Drop">
        <Grid>
          <Border CornerRadius="9"
                  Style="{StaticResource AiCardHaloStyle}" />
          <Border x:Name="SlotCardBorder"
                  Style="{StaticResource SlotCardBorderStyle}"
                  Padding="0"
                  ToolTip="{Binding AiActivityToolTip}">
          <Grid Margin="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    ToolTip="{Binding AiActivityToolTip}">
                <Border Style="{StaticResource SlotNameBadgeStyle}">
                  <TextBlock Text="{Binding Name}"
                             Style="{StaticResource SlotNameBadgeTextStyle}" />
                </Border>
                <Border CornerRadius="8"
                        BorderThickness="2"
                        Style="{StaticResource AiBadgeWorkingRingStyle}" />
              </Grid>
              <Ellipse Grid.Column="1" Style="{StaticResource LedIndicatorStyle}" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2"
                          VerticalAlignment="Center">
                <TextBox Text="{Binding PanelTitle, UpdateSourceTrigger=Explicit}"
                         Style="{StaticResource InlineTitleTextBox}"
                         FontSize="16.5"
                         FontWeight="Bold"
                         Foreground="#F8FCF9"
                         Padding="2,0"
                         MinHeight="22"
                         TextOptions.TextFormattingMode="Ideal"
                         TextOptions.TextRenderingMode="Auto"
                         MaxLength="40" />
                <TextBlock Text="{Binding ShortPath}"
                           Margin="2,0,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource MutedTextBrush}" />
              </StackPanel>
              <Button Grid.Column="3"
                      Content="&#xE75C;"
                      Tag="{Binding}"
                      Click="ClearSlotPanelInfoButton_Click"
                      Style="{StaticResource SlotClearInfoButtonStyle}"
                      VerticalAlignment="Top"
                      Margin="8,0,0,0" />
            </Grid>

            <Grid Grid.Row="1"
                  Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="98" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0"
                    Margin="0,0,6,0">
                <Border Style="{StaticResource ApplicationGroupBorderStyle}">
                  <ItemsControl ItemsSource="{Binding IdeApplicationOptions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="2,0,2,4" />
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type models:SlotApplicationOption}">
                        <Button Tag="{Binding}"
                                Click="SlotApplicationSwitchButton_Click"
                                ToolTip="{Binding ToolTip}"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource IdeApplicationSelectorButtonStyle}">
                          <TextBlock Text="{Binding ShortName}"
                                     TextTrimming="CharacterEllipsis"
                                     TextAlignment="Center" />
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Text="IDE"
                           Style="{StaticResource ApplicationGroupLabelStyle}" />
              </Grid>

              <Grid Grid.Column="1">
                <Border Style="{StaticResource ApplicationGroupBorderStyle}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0"
                                 Columns="2">
                      <ContentControl Content="{Binding CliApplicationOptions[0]}"
                                      ContentTemplate="{StaticResource CliApplicationOptionTemplate}"
                                      Margin="2,0,2,4" />
                      <ContentControl Content="{Binding CliApplicationOptions[1]}"
                                      ContentTemplate="{StaticResource CliApplicationOptionTemplate}"
                                      Margin="2,0,2,4" />
                    </UniformGrid>

                    <Grid Grid.Row="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>

                      <ContentControl Grid.Column="0"
                                      Content="{Binding CliApplicationOptions[2]}"
                                      ContentTemplate="{StaticResource CliApplicationOptionTemplate}"
                                      Margin="2,0,2,4" />
                      <ContentControl Grid.Column="1"
                                      Width="46"
                                      Content="{Binding CliApplicationOptions[3]}"
                                      ContentTemplate="{StaticResource CliApplicationOptionTemplate}"
                                      Margin="2,0,2,4" />
                      <ContentControl Grid.Column="2"
                                      Content="{Binding CliApplicationOptions[4]}"
                                      ContentTemplate="{StaticResource CliApplicationOptionTemplate}"
                                      Margin="2,0,2,4" />
                    </Grid>
                  </Grid>
                </Border>
                <TextBlock Text="CLI"
                           Style="{StaticResource ApplicationGroupLabelStyle}" />
              </Grid>
            </Grid>

            <Grid Grid.Row="2"
                  Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0"
                          Orientation="Horizontal"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                <!-- E838 (FolderOpen): E8B7 (Folder) は小サイズだと四角にしか見えないため、
                     開いたフォルダのグリフでエクスプローラを開く操作だと分かるようにする。 -->
                <Button Content="&#xE838;"
                        Tag="{Binding}"
                        Click="OpenSlotWorkspaceFolderButton_Click"
                        AutomationProperties.Name="ワークスペースフォルダを開く"
                        VerticalAlignment="Center"
                        Style="{StaticResource SlotOpenFolderButtonStyle}" />

                <Button Tag="{Binding}"
                        Click="OpenSlotGitHubButton_Click"
                        AutomationProperties.Name="GitHub のリポジトリページを開く"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0"
                        Style="{StaticResource SlotOpenGitHubButtonStyle}">
                  <Path Data="{StaticResource GitHubMarkGeometry}"
                        Width="13"
                        Height="13"
                        Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>

                <Button Content="&#xE7F4;"
                        Tag="{Binding}"
                        Click="MoveSlotToNextDisplayButton_Click"
                        AutomationProperties.Name="このパネルを次のディスプレイへ移動"
                        VerticalAlignment="Center"
                        Margin="6,0,0,0">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SlotOpenFolderButtonStyle}">
                      <Setter Property="ToolTip" Value="このパネルだけ次のディスプレイへ移動（ベースに戻すまで巡回）" />
                      <Setter Property="IsEnabled" Value="False" />
                      <Setter Property="Opacity" Value="0.4" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Ready}">
                          <Setter Property="IsEnabled" Value="True" />
                          <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>

                <Border CornerRadius="6"
                        Background="#17271E"
                        BorderBrush="{Binding DisplayBrush}"
                        BorderThickness="1"
                        Padding="6,1"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDisplayBadge}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <TextBlock Text="{Binding DisplayBadgeText}"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{Binding DisplayBrush}"
                             ToolTip="このパネルが表示されているディスプレイ" />
                </Border>
              </StackPanel>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          VerticalAlignment="Center">
                <Button Tag="{Binding}"
                        Click="StoreSlotButton_Click"
                        Margin="0,0,6,0">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SlotActionButton}">
                      <Setter Property="Content" Value="控え移動" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasPanelContent}" Value="False">
                          <Setter Property="IsEnabled" Value="False" />
                          <Setter Property="Opacity" Value="0.4" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Tag="{Binding}"
                        Click="SlotMainActionButton_Click"
                        MinWidth="64">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SlotActionButton}">
                      <Setter Property="Content" Value="閉じる" />
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Missing}" />
                            <Condition Binding="{Binding HasPanelContent}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Content" Value="起動" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Missing}" />
                            <Condition Binding="{Binding HasPanelContent}" Value="False" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Content" Value="新規" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Launching}">
                          <Setter Property="Content" Value="起動中" />
                          <Setter Property="IsEnabled" Value="False" />
                          <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
          </Border>
          <Border CornerRadius="8"
                  Style="{StaticResource AiCardPulseStyle}" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="MicroSlotTemplate" DataType="{x:Type models:WindowSlot}">
      <Button Tag="{Binding}"
              Click="MicroSlotButton_Click"
              PreviewMouseLeftButtonDown="SlotCard_PreviewMouseLeftButtonDown"
              PreviewMouseMove="SlotCard_PreviewMouseMove"
              AllowDrop="True"
              DragEnter="SlotCard_DragEnter"
              DragLeave="SlotCard_DragLeave"
              DragOver="SlotCard_DragOver"
              Drop="SlotCard_Drop"
              ToolTip="{Binding DisplayTitle}"
              Style="{StaticResource MicroSlotButtonStyle}">
        <!-- ラベルはタイトル先頭 1〜2 文字（MicroLabel）。全角 2 文字だとセル幅を超えうるので
             Viewbox の DownOnly で溢れた分だけ縮める。1 文字や半角 2 文字は 14pt のまま。
             フォントの descender 領域がセル中央計算に含まれるため、descender を持たない
             文字を視覚的中央へ移すには RenderTransform で上方向に補正する。
             レイアウトには影響せず純粋に描画位置だけ調整。 -->
        <Viewbox Stretch="Uniform"
                 StretchDirection="DownOnly"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="3,0">
          <TextBlock Text="{Binding MicroLabel}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
            <TextBlock.RenderTransform>
              <TranslateTransform Y="-1" />
            </TextBlock.RenderTransform>
          </TextBlock>
        </Viewbox>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="CompactSlotTemplate" DataType="{x:Type models:WindowSlot}">
      <Button x:Name="CompactSlotButton"
              Tag="{Binding}"
              Click="CompactSlotButton_Click"
              PreviewMouseRightButtonUp="CompactSlotCard_PreviewMouseRightButtonUp"
              PreviewMouseLeftButtonDown="SlotCard_PreviewMouseLeftButtonDown"
              PreviewMouseMove="SlotCard_PreviewMouseMove"
              AllowDrop="True"
              DragEnter="SlotCard_DragEnter"
              DragLeave="SlotCard_DragLeave"
              DragOver="SlotCard_DragOver"
              Drop="SlotCard_Drop"
              Style="{StaticResource CompactSlotButtonStyle}">
        <Grid VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Grid Margin="0,0,5,0"
                VerticalAlignment="Center"
                ToolTip="{Binding AiActivityToolTip}">
            <Border Style="{StaticResource CompactSlotBadgeStyle}">
              <TextBlock Text="{Binding Name}"
                         Style="{StaticResource CompactSlotBadgeTextStyle}" />
            </Border>
            <Border CornerRadius="4"
                    Style="{StaticResource AiBadgeWorkingRingStyle}" />
          </Grid>

          <TextBox x:Name="CompactSlotTitleBox"
                   Grid.Column="1"
                   Text="{Binding PanelTitle, UpdateSourceTrigger=Explicit}"
                   Style="{StaticResource InlineTitleTextBox}"
                   VerticalAlignment="Center"
                   MinHeight="0" Height="20" Padding="0"
                   FontSize="13" />

          <Button x:Name="CompactSlotIdeToggle"
                  Grid.Column="2"
                  Tag="{Binding}"
                  Content="{Binding CompactIdeToggleLabel}"
                  ToolTip="{Binding CompactIdeToggleToolTip}"
                  AutomationProperties.Name="{Binding CompactIdeToggleToolTip}"
                  ToolTipService.ShowOnDisabled="True"
                  IsEnabled="{Binding CanToggleCompactIde}"
                  Click="CompactSlotIdeToggleButton_Click"
                  Style="{StaticResource CompactSlotIdeToggleButtonStyle}" />
          <Button x:Name="CompactSlotPowerToggle"
                  Grid.Column="3"
                  Tag="{Binding}"
                  Click="CompactSlotPowerButton_Click"
                  Style="{StaticResource CompactSlotPowerButtonStyle}" />
          <!-- 控えカードを選んでいる間だけ、IDE 切替・起動ボタンの代わりに出す。クリックはカード本体が受ける。 -->
          <Border x:Name="CompactSlotAssignPill"
                  Grid.Column="2"
                  Grid.ColumnSpan="2"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  Height="18"
                  Margin="4,0,0,0"
                  Padding="7,0"
                  CornerRadius="9"
                  Background="#223027"
                  BorderBrush="{StaticResource AccentBrush}"
                  BorderThickness="1">
            <TextBlock Text="▶ ここに表示"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="10"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Button>
      <DataTemplate.Triggers>
        <!-- 配置先として選ぶ間は、名前のクリック（フォーカス切替・名前編集）もカード本体のクリックとして扱う。 -->
        <Trigger SourceName="CompactSlotButton" Property="local:SlotAssignTarget.IsArmed" Value="True">
          <Setter TargetName="CompactSlotTitleBox" Property="IsHitTestVisible" Value="False" />
          <Setter TargetName="CompactSlotIdeToggle" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="CompactSlotPowerToggle" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="CompactSlotAssignPill" Property="Visibility" Value="Visible" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 控えカードと縮小表示のスロットカードの右クリックメニュー（項目はコードビハインドで組み立てる）。既定の白いメニューではなく、
         パネルの配色と角丸に合わせる。右端の補足（InputGestureText）には配置先の現在の内容などを出す。 -->
    <Style x:Key="PanelContextMenuStyle" TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="HasDropShadow" Value="False" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Margin="0,0,8,8"
                    Padding="4"
                    MinWidth="220"
                    CornerRadius="10"
                    Background="#1D2622"
                    BorderBrush="#3E5148"
                    BorderThickness="1">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
              </Border.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Resources>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Separator">
                <Rectangle Height="1" Margin="8,4" Fill="{StaticResource BorderBrushSoft}" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style TargetType="MenuItem">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          <Setter Property="Padding" Value="6,5,12,5" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="MenuItem">
                <Grid>
                  <Border x:Name="ItemBorder"
                          Background="Transparent"
                          CornerRadius="6"
                          Padding="{TemplateBinding Padding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter ContentSource="Icon"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                      <ContentPresenter Grid.Column="1"
                                        ContentSource="Header"
                                        RecognizesAccessKey="True"
                                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="{TemplateBinding InputGestureText}"
                                 MaxWidth="150"
                                 Margin="16,0,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock x:Name="SubmenuArrow"
                                 Grid.Column="3"
                                 Text="&#xE76C;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="9"
                                 Margin="8,0,-4,0"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 VerticalAlignment="Center"
                                 Visibility="Collapsed" />
                    </Grid>
                  </Border>
                  <!-- IDE / CLI の切り替えなど、1 階層だけのサブメニュー。 -->
                  <Popup x:Name="PART_Popup"
                         Placement="Right"
                         HorizontalOffset="2"
                         VerticalOffset="-5"
                         AllowsTransparency="True"
                         Focusable="False"
                         PopupAnimation="Fade"
                         IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border Margin="0,0,8,8"
                            Padding="4"
                            MinWidth="160"
                            CornerRadius="10"
                            Background="#1D2622"
                            BorderBrush="#3E5148"
                            BorderThickness="1">
                      <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="2" Opacity="0.45" />
                      </Border.Effect>
                      <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                  </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                  </Trigger>
                  <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#25302A" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4" />
                    <Setter Property="Cursor" Value="Arrow" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Style.Resources>
    </Style>

    <!-- 縮小表示の控えカード。A〜D ボタンは持たず、クリックで選んでから上のスロット A〜D を押して配置する
         （選択中は IsOverviewSelected。標準表示の控え一覧と同じ選択を使う）。 -->
    <DataTemplate x:Key="CompactStoredPanelTemplate" DataType="{x:Type models:StoredPanelSlot}">
      <Border CornerRadius="6"
              Padding="5,4"
              Cursor="Hand"
              Tag="{Binding}"
              PreviewMouseLeftButtonDown="CompactStoredCard_PreviewMouseLeftButtonDown"
              PreviewMouseMove="StoredPanelCard_PreviewMouseMove"
              PreviewMouseRightButtonUp="StoredPanelCard_PreviewMouseRightButtonUp"
              AllowDrop="True"
              DragEnter="StoredPanelCard_DragEnter"
              DragLeave="StoredPanelCard_DragLeave"
              DragOver="StoredPanelCard_DragOver"
              Drop="StoredPanelCard_Drop">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#3D4E45" />
              </Trigger>
              <DataTrigger Binding="{Binding IsOverviewSelected}" Value="True">
                <Setter Property="Background" Value="#1A2C21" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="18" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="20" Height="18" CornerRadius="4" Background="#223027"
                    BorderBrush="#335A43" BorderThickness="1" Margin="0,0,5,0">
              <TextBlock Text="{Binding Label}" Foreground="{StaticResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontWeight="SemiBold" FontSize="12" />
            </Border>
            <TextBox Grid.Column="1" Text="{Binding PanelTitle, UpdateSourceTrigger=Explicit}"
                     Style="{StaticResource InlineTitleTextBox}"
                     FontSize="12" VerticalAlignment="Center"
                     MinHeight="0" Height="21" Padding="0" />
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="&#xED25;" Tag="{Binding}"
                    Click="RegisterStoredPanelFolderButton_Click"
                    Style="{StaticResource StoredRegisterFolderButton}"
                    Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                    ToolTip="フォルダを控えに登録" />
            <Button Content="&#xE75C;" Tag="{Binding}"
                    Click="DeleteStoredPanelButton_Click"
                    Style="{StaticResource StoredDeleteButton}"
                    Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                    IsEnabled="{Binding HasContent}" ToolTip="控えをクリア（フォルダは削除されません）" />
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ShortPath}"
                     ToolTip="{Binding WorkspacePath}" Foreground="{StaticResource MutedTextBrush}"
                     FontSize="11.5" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CompactStoredPageTemplate" DataType="{x:Type models:StoredPanelPage}">
      <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource CompactStoredPanelTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Margin" Value="2" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="StoredPanelTemplate" DataType="{x:Type models:StoredPanelSlot}">
      <Border Style="{StaticResource StoredCardBorderStyle}"
              Tag="{Binding}"
              PreviewMouseLeftButtonDown="StoredPanelCard_PreviewMouseLeftButtonDown"
              PreviewMouseMove="StoredPanelCard_PreviewMouseMove"
              PreviewMouseRightButtonUp="StoredPanelCard_PreviewMouseRightButtonUp"
              AllowDrop="True"
              DragEnter="StoredPanelCard_DragEnter"
              DragLeave="StoredPanelCard_DragLeave"
              DragOver="StoredPanelCard_DragOver"
              Drop="StoredPanelCard_Drop">
        <Grid Height="104">
          <Grid.RowDefinitions>
            <RowDefinition Height="24" />
            <RowDefinition Height="19" />
            <RowDefinition Height="61" />
          </Grid.RowDefinitions>

          <TextBox x:Name="StoredPanelTitle"
                   Text="{Binding PanelTitle, UpdateSourceTrigger=Explicit}"
                   Style="{StaticResource InlineTitleTextBox}"
                   FontSize="14.5"
                   VerticalAlignment="Center" />

          <Grid Grid.Row="1" Margin="0,3,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="20" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}"
                       Margin="0,0,6,0"
                       TextAlignment="Right"
                       Typography.NumeralAlignment="Tabular"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="12" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding ShortPath}"
                       ToolTip="{Binding WorkspacePath}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" TextTrimming="CharacterEllipsis" />
          </Grid>

          <Grid Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <Button Grid.Row="0" Grid.Column="0" Content="A" Tag="{Binding}"
                      CommandParameter="A" Click="ShowStoredPanelButton_Click"
                      Style="{StaticResource StoredAssignButton}"
                      HorizontalAlignment="Stretch" Margin="0,0,4,4"
                      FontSize="12.5"
                      IsEnabled="{Binding HasContent}" />
              <Button Grid.Row="0" Grid.Column="1" Content="B" Tag="{Binding}"
                      CommandParameter="B" Click="ShowStoredPanelButton_Click"
                      Style="{StaticResource StoredAssignButton}"
                      HorizontalAlignment="Stretch" Margin="4,0,0,4"
                      FontSize="12.5"
                      IsEnabled="{Binding HasContent}" />
              <Button Grid.Row="1" Grid.Column="0" Content="C" Tag="{Binding}"
                      CommandParameter="C" Click="ShowStoredPanelButton_Click"
                      Style="{StaticResource StoredAssignButton}"
                      HorizontalAlignment="Stretch" Margin="0,4,4,0"
                      FontSize="12.5"
                      IsEnabled="{Binding HasContent}" />
              <Button Grid.Row="1" Grid.Column="1" Content="D" Tag="{Binding}"
                      CommandParameter="D" Click="ShowStoredPanelButton_Click"
                      Style="{StaticResource StoredAssignButton}"
                      HorizontalAlignment="Stretch" Margin="4,4,0,0"
                      FontSize="12.5"
                      IsEnabled="{Binding HasContent}" />
            </Grid>

            <Button Grid.Column="1" Content="&#xED25;" Tag="{Binding}"
                    Click="RegisterStoredPanelFolderButton_Click"
                    Style="{StaticResource StoredRegisterFolderButton}"
                    AutomationProperties.Name="フォルダを選んでこの控えに登録"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" />
            <Button Grid.Column="1" Content="&#xE75C;" Tag="{Binding}"
                    Click="DeleteStoredPanelButton_Click"
                    Style="{StaticResource StoredDeleteButton}"
                    AutomationProperties.Name="この控えをクリア"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    IsEnabled="{Binding HasContent}" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="StoredPanelPageTemplate" DataType="{x:Type models:StoredPanelPage}">
      <ItemsControl ItemsSource="{Binding Slots}"
                    ItemTemplate="{StaticResource StoredPanelTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Margin" Value="0,0,4,0" />
          </Style>
        </ItemsControl.ItemContainerStyle>
      </ItemsControl>
    </DataTemplate>

    <!-- 控えタブのツールチップ。名前に加えて、そのタブに入っている控えカードを並べる。 -->
    <DataTemplate x:Key="StoredPageToolTipTemplate" DataType="{x:Type models:StoredPanelPage}">
      <StackPanel MaxWidth="360">
        <TextBlock Text="{Binding Header}"
                   Foreground="{StaticResource AccentBrush}"
                   FontSize="14"
                   FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Slots}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:StoredPanelSlot}">
              <DockPanel x:Name="StoredCardLine" Margin="0,1.5,0,1.5">
                <Ellipse Width="6"
                         Height="6"
                         Margin="1,0,8,0"
                         VerticalAlignment="Center"
                         Fill="{StaticResource AccentBrush}"
                         DockPanel.Dock="Left" />
                <TextBlock Text="{Binding DisplayTitle}"
                           FontSize="13.5"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasContent}" Value="False">
                  <Setter TargetName="StoredCardLine" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="クリックで切り替え、ダブルクリックで名前を変更"
                   Margin="0,7,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="11.5" />
      </StackPanel>
    </DataTemplate>

    <!-- 控えタブ用の角丸ツールチップ。既定の四角いシステム表示ではなく、パネルの配色に合わせる。
         影のぶん外側に余白を取り、ポップアップ自体は透明にして角丸を活かす。 -->
    <Style x:Key="StoredPageToolTipStyle" TargetType="ToolTip">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="HasDropShadow" Value="False" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="ContentTemplate" Value="{StaticResource StoredPageToolTipTemplate}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Margin="8"
                    Padding="13,9,15,10"
                    CornerRadius="12"
                    Background="#1D2622"
                    BorderBrush="#4F8466"
                    BorderThickness="2">
              <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45" />
              </Border.Effect>
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 控え一覧のタイル。配置ボタンは持たず、選択とドラッグ（タイル同士の並べ替えも）を受け持つ。
         配置先は一覧上部の A〜D パッド、またはメインのスロットカードへのドロップで決める。
         6 ページ分がスクロールなしで収まるよう、横長・低めにして文字を大きく取る。
         一覧がパネルより低いときは、余った高さを 6 段へ均等に配って下端までぴったり埋める。 -->
    <!-- 控え一覧のスクロールバー。Windows 標準の白い太いバーではなく、パネル配色の細い角丸にする。
         矢印ボタンは置かず、つまみのドラッグ・溝のクリック・ホイールで動かす。 -->
    <Style x:Key="SlimScrollBarStyle" TargetType="ScrollBar">
      <Setter Property="Width" Value="6" />
      <Setter Property="MinWidth" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="#141A17" CornerRadius="3">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" MinHeight="24" CornerRadius="3" Background="#3E5148" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#5E7568" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#3B7A55" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 縦スクロール専用。バーは中身に重ねず右に専用の溝（間隔 5）を取り、スクロールが要るときだけ出す。 -->
    <Style x:Key="SlimScrollViewerStyle" TargetType="ScrollViewer">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollViewer">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      CanContentScroll="{TemplateBinding CanContentScroll}" />
              <ScrollBar x:Name="PART_VerticalScrollBar"
                         Grid.Column="1"
                         Margin="5,0,0,0"
                         Orientation="Vertical"
                         Style="{StaticResource SlimScrollBarStyle}"
                         Value="{TemplateBinding VerticalOffset}"
                         Maximum="{TemplateBinding ScrollableHeight}"
                         ViewportSize="{TemplateBinding ViewportHeight}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="StoredOverviewTileTemplate" DataType="{x:Type models:StoredPanelSlot}">
      <Border x:Name="TileBorder"
              MinHeight="62"
              Padding="7,4,7,4"
              CornerRadius="7"
              Background="{StaticResource SurfaceAltBrush}"
              BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1"
              Cursor="Hand"
              Tag="{Binding}"
              PreviewMouseLeftButtonDown="StoredPanelCard_PreviewMouseLeftButtonDown"
              PreviewMouseMove="StoredPanelCard_PreviewMouseMove"
              PreviewMouseRightButtonUp="StoredPanelCard_PreviewMouseRightButtonUp"
              MouseLeftButtonUp="StoredOverviewTile_MouseLeftButtonUp"
              AllowDrop="True"
              DragEnter="StoredOverviewTile_DragEnter"
              DragLeave="StoredOverviewTile_DragLeave"
              DragOver="StoredOverviewTile_DragOver"
              Drop="StoredOverviewTile_Drop">
        <Border.ToolTip>
          <TextBlock>
            <Run Text="{Binding DisplayTitle, Mode=OneWay}" FontWeight="SemiBold" />
            <LineBreak />
            <Run Text="{Binding WorkspacePath, Mode=OneWay}" />
            <LineBreak />
            <Run Text="{Binding ApplicationShortName, Mode=OneWay}" />
          </TextBlock>
        </Border.ToolTip>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="TileTitleText"
                     Text="{Binding DisplayTitle}"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="12.5"
                     FontWeight="SemiBold"
                     LineHeight="16"
                     LineStackingStrategy="BlockLineHeight"
                     MaxHeight="32"
                     TextWrapping="Wrap"
                     TextTrimming="CharacterEllipsis" />
          <DockPanel x:Name="TileFooter" Grid.Row="1" LastChildFill="True">
            <TextBlock Text="{Binding Label}"
                       DockPanel.Dock="Left"
                       Margin="0,0,5,0"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular" />
            <!-- ほとんどが VS Code なので、それ以外のアプリのときだけ名前を出す。 -->
            <TextBlock x:Name="TileApplicationText"
                       Text="{Binding ApplicationShortName}"
                       DockPanel.Dock="Right"
                       Margin="4,0,0,0"
                       Foreground="#B9A2D6"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TilePathText"
                       Text="{Binding ShortPath}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10.5"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="TileBorder" Property="IsMouseOver" Value="True">
          <Setter TargetName="TileBorder" Property="Background" Value="#202A25" />
          <Setter TargetName="TileBorder" Property="BorderBrush" Value="#3E5148" />
        </Trigger>
        <DataTrigger Binding="{Binding ApplicationId}" Value="vscode">
          <Setter TargetName="TileApplicationText" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding HasContent}" Value="False">
          <Setter TargetName="TileBorder" Property="Opacity" Value="0.38" />
          <Setter TargetName="TileBorder" Property="Background" Value="Transparent" />
          <Setter TargetName="TileBorder" Property="Cursor" Value="Arrow" />
          <Setter TargetName="TileBorder" Property="ToolTip" Value="空き" />
          <Setter TargetName="TileTitleText" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
          <Setter TargetName="TileTitleText" Property="FontWeight" Value="Normal" />
          <Setter TargetName="TileApplicationText" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="TilePathText" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <!-- 縮小表示の一覧は高さが限られるので、番号・フォルダ名の行を省いて名前だけの低いタイルにする
             （フォルダ名などはツールチップで見られる）。local:CompactLayout.IsActive は StoredOverviewRoot から継承。 -->
        <Trigger SourceName="TileBorder" Property="local:CompactLayout.IsActive" Value="True">
          <Setter TargetName="TileBorder" Property="MinHeight" Value="36" />
          <Setter TargetName="TileBorder" Property="Padding" Value="6,3,6,3" />
          <Setter TargetName="TileFooter" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="TileTitleText" Property="FontSize" Value="12" />
          <Setter TargetName="TileTitleText" Property="LineHeight" Value="15" />
          <Setter TargetName="TileTitleText" Property="MaxHeight" Value="30" />
          <Setter TargetName="TileTitleText" Property="VerticalAlignment" Value="Center" />
        </Trigger>
        <DataTrigger Binding="{Binding IsOverviewSelected}" Value="True">
          <Setter TargetName="TileBorder" Property="Background" Value="#223027" />
          <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter TargetName="TileBorder" Property="Effect">
            <Setter.Value>
              <DropShadowEffect Color="#45D483" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
            </Setter.Value>
          </Setter>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="StoredOverviewPageTemplate" DataType="{x:Type models:StoredPanelPage}">
      <Grid Margin="0,0,0,5">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel x:Name="PageHeaderRow" Margin="1,0,0,3">
          <TextBlock x:Name="PageHeaderText"
                     Text="{Binding Header}"
                     DockPanel.Dock="Left"
                     Foreground="{StaticResource MutedTextBrush}"
                     FontSize="11.5"
                     FontWeight="SemiBold"
                     Margin="0,0,8,0"
                     Cursor="Hand"
                     ToolTip="クリックで控えパネルをこのタブに切り替え"
                     MouseLeftButtonUp="StoredOverviewPageHeader_MouseLeftButtonUp" />
          <Rectangle Height="1"
                     VerticalAlignment="Center"
                     Fill="{StaticResource BorderBrushSoft}" />
        </DockPanel>
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Slots}"
                      ItemTemplate="{StaticResource StoredOverviewTileTemplate}"
                      Margin="0,0,-6,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Margin" Value="0,0,6,0" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>
      </Grid>
      <DataTemplate.Triggers>
        <!-- 控えパネルで今開いているタブを一覧でも見分けられるようにする。 -->
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="PageHeaderText" Property="Foreground" Value="{StaticResource AccentBrush}" />
        </DataTrigger>
        <!-- 縮小表示の一覧は見出しを縮小表示の控えタブ（11）と同じくらいに抑え、ページの間隔も詰める。 -->
        <Trigger SourceName="PageHeaderText" Property="local:CompactLayout.IsActive" Value="True">
          <Setter TargetName="PageHeaderText" Property="FontSize" Value="11" />
          <Setter TargetName="PageHeaderRow" Property="Margin" Value="1,0,0,2" />
        </Trigger>
        <Trigger SourceName="PageHeaderText" Property="IsMouseOver" Value="True">
          <Setter TargetName="PageHeaderText" Property="TextDecorations" Value="Underline" />
          <Setter TargetName="PageHeaderText" Property="Foreground" Value="{StaticResource TextBrush}" />
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 一覧上部の配置先パッド。メインの 2x2 と同じ並びで、今そこにある内容も見せる。
         一覧でカードを選ぶとパッド（UniformGrid）の Tag が "Armed" になり、押せる状態を強調する。 -->
    <Style x:Key="StoredOverviewTargetButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#17201B" />
      <Setter Property="BorderBrush" Value="#2E3832" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AllowDrop" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Tag" Value="{Binding}" />
      <EventSetter Event="Click" Handler="StoredOverviewTargetButton_Click" />
      <EventSetter Event="DragEnter" Handler="SlotCard_DragEnter" />
      <EventSetter Event="DragLeave" Handler="SlotCard_DragLeave" />
      <EventSetter Event="DragOver" Handler="SlotCard_DragOver" />
      <EventSetter Event="Drop" Handler="SlotCard_Drop" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="TargetBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="8,0,8,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TargetLetter"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#7F9A8A"
                           FontSize="20"
                           FontWeight="Bold" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayTitle}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ApplicationBadgeText}"
                             Margin="0,0,0,0"
                             Foreground="{StaticResource MutedTextBrush}"
                             FontSize="10.5"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UniformGrid}}" Value="Armed">
                <Setter TargetName="TargetBorder" Property="BorderBrush" Value="#3B7A55" />
                <Setter TargetName="TargetLetter" Property="Foreground" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TargetBorder" Property="Background" Value="#223027" />
                <Setter TargetName="TargetBorder" Property="BorderBrush" Value="#5E7568" />
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UniformGrid}}" Value="Armed" />
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="TargetBorder" Property="Background" Value="#24402F" />
                <Setter TargetName="TargetBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </MultiDataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="TargetBorder" Property="Background" Value="#18201B" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="StoredOverviewToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource BarButton}">
      <Style.Triggers>
        <Trigger Property="Tag" Value="Active">
          <Setter Property="Background" Value="#223027" />
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="DiskCleanupCandidateTemplate" DataType="{x:Type models:DiskCleanupCandidate}">
      <Border Margin="0,0,0,6"
              Padding="8,7"
              Background="#1B221E"
              BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1"
              CornerRadius="8"
              ToolTip="{Binding ToolTipText}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <CheckBox Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                    IsEnabled="{Binding CanDelete}"
                    Click="DiskCleanupCandidateCheckBox_Click" />
          <Border Grid.Column="1"
                  MinWidth="40"
                  Margin="0,0,8,0"
                  Padding="6,2"
                  CornerRadius="5"
                  BorderThickness="1"
                  VerticalAlignment="Center"
                  Background="{Binding SafetyBackgroundBrush}"
                  BorderBrush="{Binding SafetyBorderBrush}">
            <TextBlock Text="{Binding SafetyText}"
                       FontSize="10.5"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{Binding SafetyForegroundBrush}" />
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Margin="0,2,0,0"
                       Text="{Binding ReasonText}"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
          <StackPanel Grid.Column="3"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center">
            <TextBlock Text="{Binding SizeText}"
                       FontSize="13"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"
                       Foreground="{Binding SafetyForegroundBrush}" />
            <TextBlock Text="{Binding LastWriteText}"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedTextBrush}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <!-- ウィンドウ自体は DWM で角丸にする（OnSourceInitialized）。縮小表示の緑枠もその丸みに沿わせる。 -->
  <Border x:Name="PanelFrameBorder"
          Background="Transparent"
          BorderBrush="Transparent"
          BorderThickness="0"
          CornerRadius="8">
    <Grid x:Name="RootLayoutGrid" Background="{StaticResource PanelBackgroundBrush}" Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="26" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 控え一覧。メインの 4 カードを隠さないよう、パネルの外側（画面の空きが広い側）へ
         別ウィンドウとして横付けする。位置と高さはコードビハインドでパネルに追従させ、
         上端・下端をパネルと揃える（中身が入りきらないときだけ一覧をスクロールする）。 -->
    <Popup x:Name="StoredOverviewPopup"
           PlacementTarget="{Binding ElementName=PanelFrameBorder}"
           Placement="Custom"
           AllowsTransparency="True"
           StaysOpen="True"
           PopupAnimation="None"
           Focusable="False"
           Opened="StoredOverviewPopup_Opened">
      <Border x:Name="StoredOverviewRoot"
              Width="460"
              Opacity="0"
              Padding="10,6,10,8"
              Background="{StaticResource PanelBackgroundBrush}"
              BorderBrush="#3E5148"
              BorderThickness="1"
              CornerRadius="10">
        <Border.RenderTransform>
          <TranslateTransform x:Name="StoredOverviewTranslate" />
        </Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right"
                    Content="&#xE711;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="10"
                    Width="26"
                    Height="24"
                    ToolTip="一覧を閉じる"
                    AutomationProperties.Name="控えの一覧を閉じる"
                    Click="CloseStoredOverviewButton_Click"
                    Style="{StaticResource ChromeButton}" />
            <TextBlock x:Name="StoredOverviewTitleText"
                       Text="控え一覧"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0" />
            <TextBlock x:Name="StoredOverviewHintText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11.5"
                       TextTrimming="CharacterEllipsis" />
          </DockPanel>

          <UniformGrid x:Name="StoredOverviewTargetPad"
                       Grid.Row="1"
                       Rows="2"
                       Columns="2"
                       Margin="0,0,0,9">
            <Button DataContext="{Binding Slots[0]}" Style="{StaticResource StoredOverviewTargetButtonStyle}" Margin="0,0,3,3" />
            <Button DataContext="{Binding Slots[1]}" Style="{StaticResource StoredOverviewTargetButtonStyle}" Margin="3,0,0,3" />
            <Button DataContext="{Binding Slots[2]}" Style="{StaticResource StoredOverviewTargetButtonStyle}" Margin="0,3,3,0" />
            <Button DataContext="{Binding Slots[3]}" Style="{StaticResource StoredOverviewTargetButtonStyle}" Margin="3,3,0,0" />
          </UniformGrid>

          <ScrollViewer Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        Style="{StaticResource SlimScrollViewerStyle}">
            <!-- 表示領域いっぱいを下限にして 6 段を均等割りする。入りきらないときだけスクロール。 -->
            <ItemsControl x:Name="StoredOverviewPagesList"
                          ItemsSource="{Binding StoredPanelPages}"
                          ItemTemplate="{StaticResource StoredOverviewPageTemplate}"
                          MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Popup>

    <Grid Grid.Row="0">
      <TextBlock x:Name="WindowTitleText"
                 Text="Turtle AI Code Quartet Hub"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource TextBrush}" />
      <StackPanel x:Name="TitleBarButtonsPanel"
                  HorizontalAlignment="Right"
                  Orientation="Horizontal">
        <!-- VS Code と同じく、ツール系（モニタ・PR・設定・ヘルプ）は詰めてひとまとまりにし、
             右端の表示切替・最小化・閉じるとは間を空ける。標準表示のときだけ出す（コードで切り替え）。 -->
        <StackPanel x:Name="TitleBarToolButtonsPanel"
                    Orientation="Horizontal"
                    Margin="0,0,14,0">
          <!-- アイコン色でシステム全体の状況（緑＝正常・黄＝注意・赤＝警告）を示す。色とツールチップはコードで更新する。 -->
          <Button x:Name="SystemMonitorButton"
                  Content="&#xE9D9;"
                  Width="26"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="12"
                  FontWeight="SemiBold"
                  ToolTip="システムモニタ"
                  AutomationProperties.Name="システムモニタ"
                  Click="SystemMonitorButton_Click"
                  Style="{StaticResource TitleBarChromeButton}" />
          <!-- 未読の PR 通知があると右下に赤丸（local:UpdateBadge.IsActive）を出す。ツールチップはコードで更新する。 -->
          <Button x:Name="PullRequestInboxButton"
                  Width="26"
                  Margin="2,0,0,0"
                  ToolTip="GitHub の Pull Request 受信箱を開く（github.com/pulls/inbox）"
                  AutomationProperties.Name="GitHub の Pull Request 受信箱を開く"
                  Click="PullRequestInboxButton_Click"
                  Style="{StaticResource TitleBarChromeButton}">
            <Path Data="{StaticResource GitPullRequestGeometry}"
                  Width="13"
                  Height="13"
                  Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </Button>
          <Button x:Name="SettingsButton"
                  Content="&#xE713;"
                  Width="26"
                  Margin="2,0,0,0"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="12"
                  FontWeight="SemiBold"
                  ToolTip="設定"
                  Click="SettingsButton_Click"
                  Style="{StaticResource TitleBarChromeButton}" />
          <Button x:Name="HelpButton"
                  Content="？"
                  Width="26"
                  Margin="2,0,0,0"
                  FontSize="12"
                  FontWeight="SemiBold"
                  ToolTip="ヘルプ"
                  Click="HelpButton_Click"
                  Style="{StaticResource TitleBarChromeButton}" />
        </StackPanel>
        <!-- 表示切替・最小化・閉じるの間隔（Margin）と幅は表示モードに合わせてコードで設定する。 -->
        <Button x:Name="StandardJumpButton"
                Content="&#xE740;"
                Width="26"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                FontWeight="SemiBold"
                Visibility="Collapsed"
                ToolTip="標準表示へ戻す"
                 AutomationProperties.Name="標準表示へ戻す"
                Click="StandardJumpButton_Click"
                Style="{StaticResource TitleBarChromeButton}" />
        <Button x:Name="CompactJumpButton"
                Content="&#xE73F;"
                Width="23"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                FontWeight="SemiBold"
                Visibility="Collapsed"
                ToolTip="縮小表示へ切り替え"
                AutomationProperties.Name="縮小表示へ切り替え"
                Click="CompactJumpButton_Click"
                Style="{StaticResource TitleBarChromeButton}" />
        <Button x:Name="DisplayModeButton"
                Content="&#xE73F;"
                Width="32"
                FontFamily="Segoe MDL2 Assets"
                FontSize="12"
                FontWeight="SemiBold"
                ToolTip="縮小表示へ切り替え"
                Click="DisplayModeButton_Click"
                Style="{StaticResource TitleBarChromeButton}" />
        <!-- 最小化（－）と閉じる（✕）は VS Code と同じ Windows の標準キャプション記号（ChromeMinimize / ChromeClose）。 -->
        <Button x:Name="MinimizeButton"
                Content="&#xE921;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="10"
                ToolTip="最小化"
                AutomationProperties.Name="最小化"
                Click="MinimizeButton_Click"
                Style="{StaticResource TitleBarChromeButton}" />
        <Button x:Name="CloseButton"
                Content="&#xE8BB;"
                FontFamily="Segoe MDL2 Assets"
                FontSize="10"
                ToolTip="パネルを閉じる"
                AutomationProperties.Name="パネルを閉じる"
                Click="CloseButton_Click"
                Style="{StaticResource TitleBarChromeButton}" />
      </StackPanel>
    </Grid>

    <!-- ScrollContentPresenter のクリップで光の外縁が切れないよう、表示枠だけ外へ広げて内側余白で相殺する。 -->
    <ScrollViewer x:Name="StandardSlotsGrid"
                  Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Margin="-8,-7,-4,-7"
                  Padding="0">
      <UniformGrid Columns="2"
                   Rows="2"
                   Margin="8,7,8,7"
                   VerticalAlignment="Top">
        <ContentControl
                        Content="{Binding Slots[0]}"
                        ContentTemplate="{StaticResource SlotCardTemplate}"
                        Margin="5" />
        <ContentControl
                        Content="{Binding Slots[1]}"
                        ContentTemplate="{StaticResource SlotCardTemplate}"
                        Margin="5" />
        <ContentControl
                        Content="{Binding Slots[2]}"
                        ContentTemplate="{StaticResource SlotCardTemplate}"
                        Margin="5" />
        <ContentControl
                        Content="{Binding Slots[3]}"
                        ContentTemplate="{StaticResource SlotCardTemplate}"
                        Margin="5" />
      </UniformGrid>
    </ScrollViewer>

    <Border x:Name="CompactBarPanel"
            Grid.Row="1"
            Visibility="Collapsed"
            VerticalAlignment="Top"
            Margin="5,3,5,0"
            Padding="3"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0"
                        Grid.Column="0"
                        Content="{Binding Slots[0]}"
                        ContentTemplate="{StaticResource CompactSlotTemplate}"
                        Margin="0,0,3,3" />
        <ContentControl Grid.Row="0"
                        Grid.Column="1"
                        Content="{Binding Slots[1]}"
                        ContentTemplate="{StaticResource CompactSlotTemplate}"
                        Margin="0,0,3,3" />
        <ContentControl Grid.Row="1"
                        Grid.Column="0"
                        Content="{Binding Slots[2]}"
                        ContentTemplate="{StaticResource CompactSlotTemplate}"
                        Margin="0,0,3,0" />
        <ContentControl Grid.Row="1"
                        Grid.Column="1"
                        Content="{Binding Slots[3]}"
                        ContentTemplate="{StaticResource CompactSlotTemplate}"
                        Margin="0,0,3,0" />

        <Button x:Name="CompactVisibilityButton"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="2"
                Content="非"
                ToolTip="管理中ウィンドウを非表示"
                Click="CompactVisibilityButton_Click"
                Style="{StaticResource MicroCenterButtonStyle}" />

        <Button Grid.Row="0"
                Grid.Column="2"
                Content="前"
                ToolTip="管理中ウィンドウを最前面にする"
                AutomationProperties.Name="管理中ウィンドウを最前面にする"
                Click="PinAllTopButton_Click"
                Style="{StaticResource CompactBarActionButtonStyle}"
                Margin="0,0,0,3" />
        <Button Grid.Row="1"
                Grid.Column="2"
                Content="背"
                ToolTip="管理中ウィンドウを最背面にする"
                AutomationProperties.Name="管理中ウィンドウを最背面にする"
                Click="SendAllBackButton_Click"
                Style="{StaticResource CompactBarActionButtonStyle}" />
      </Grid>
    </Border>

    <Border x:Name="MicroPanel"
            Grid.Row="1"
            Visibility="Collapsed"
            Margin="2,3,2,4"
            Padding="2"
            Height="64"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <UniformGrid Rows="2" Columns="2">
          <ContentControl Content="{Binding Slots[0]}"
                          ContentTemplate="{StaticResource MicroSlotTemplate}" />
          <ContentControl Content="{Binding Slots[1]}"
                          ContentTemplate="{StaticResource MicroSlotTemplate}" />
          <ContentControl Content="{Binding Slots[2]}"
                          ContentTemplate="{StaticResource MicroSlotTemplate}" />
          <ContentControl Content="{Binding Slots[3]}"
                          ContentTemplate="{StaticResource MicroSlotTemplate}" />
        </UniformGrid>

        <!-- 4 面の交差点に重ねた円形ボタン。スロット配置の空間メタファーを保ったまま
             全体に効くアクション(全ウィンドウの表示/非表示トグル)を表す。 -->
        <Button x:Name="MicroVisibilityButton"
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Content="非"
                ToolTip="管理中ウィンドウを非表示"
                Click="MicroVisibilityButton_Click"
                Style="{StaticResource MicroCenterButtonStyle}" />
      </Grid>
    </Border>

    <Grid x:Name="StoredPanelsRowGrid" Grid.Row="2" Margin="5,2,5,3">
      <!-- 右列は AI アプリの行。標準表示の控え Quartet は両列にまたがり、見出しの右上に AI アプリが重なる。 -->
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Expander x:Name="StoredPanelsExpander"
                Grid.ColumnSpan="2"
                Style="{StaticResource StoredPanelsExpanderStyle}"
                IsExpanded="False"
                Expanded="StoredPanelsExpander_Expanded"
                Collapsed="StoredPanelsExpander_Collapsed"
                Margin="0">
        <Expander.Header>
          <Grid Height="28">
            <TextBlock Text="控え Quartet（クリックで開く）"
                     Foreground="{StaticResource TextBrush}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          </Grid>
        </Expander.Header>
            <Border x:Name="StoredPanelsExpanderContent"
              Background="{StaticResource SurfaceBrush}"
              BorderBrush="{StaticResource BorderBrushSoft}"
              BorderThickness="1"
              CornerRadius="8"
              Margin="0,12,0,0"
              Padding="6">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0" ItemsSource="{Binding StoredPanelPages}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:StoredPanelPage}">
                  <!-- タブ本体と、ダブルクリックで前に出る名前編集用の入力欄を重ねている。 -->
                  <Grid>
                    <Button Content="{Binding Header}"
                            Tag="{Binding}"
                            Click="StoredPanelPageTab_Click"
                            MouseDoubleClick="StoredPanelPageTab_MouseDoubleClick"
                            Style="{StaticResource StoredPageTabButtonStyle}">
                      <Button.ToolTip>
                        <!-- 名前が省略表示されても、ここで全文と中身の控えを確認できる。 -->
                        <ToolTip Content="{Binding}" Style="{StaticResource StoredPageToolTipStyle}" />
                      </Button.ToolTip>
                    </Button>
                    <TextBox x:Name="PageHeaderEditBox"
                             Tag="{Binding}"
                             Visibility="Collapsed"
                             Text="{Binding Header, Mode=OneWay}"
                             MaxLength="20"
                             Margin="0,0,6,4"
                             Height="22"
                             Padding="4,0"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Background="#223027"
                             Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource TextBrush}"
                             SelectionBrush="{StaticResource AccentBrush}"
                             BorderBrush="{StaticResource AccentBrush}"
                             BorderThickness="1"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             KeyDown="StoredPanelPageHeaderEditBox_KeyDown"
                             LostFocus="StoredPanelPageHeaderEditBox_LostFocus" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top"
                        Margin="12,0,4,4">
              <!-- 整列は控えタブと同じ幅（StoredPageTabButtonStyle の MinWidth）に揃える。 -->
              <Button x:Name="CompactStoredPanelsButton"
                      Content="整列"
                      Click="CompactStoredPanelsButton_Click"
                      Style="{StaticResource BarButton}"
                      Width="64"
                      Height="22"
                      MinHeight="22"
                      FontSize="12"
                      Padding="8,0"
                      Margin="0,0,6,0"
                      ToolTip="控えの空き（歯抜け）を前に詰めて整列します。ページをまたいで詰めます。" />
              <Button x:Name="StoredOverviewButton"
                      Click="StoredOverviewButton_Click"
                      Style="{StaticResource StoredOverviewToggleButtonStyle}"
                      MinWidth="96"
                      Height="22"
                      MinHeight="22"
                      FontSize="12"
                      Padding="8,0"
                      AutomationProperties.Name="控えの一覧を開く"
                      ToolTip="すべての控えを横に一覧表示します。カードを選んで A〜D を押すか、カードをスロットへドラッグして配置できます。">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE8A9;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="10"
                             VerticalAlignment="Center"
                             Margin="0,0,5,0" />
                  <TextBlock Text="一覧" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <ContentControl Grid.Row="1"
                          Content="{Binding SelectedStoredPanelPage}"
                          ContentTemplate="{StaticResource StoredPanelPageTemplate}" />
        </Grid>
      </Border>
      </Expander>

      <!-- 標準表示の控え Quartet の見出しと同じく、AI アプリの手前まで押せるように横に広げる。 -->
      <Button x:Name="CompactStoredPanelsToggleButton"
                Height="24"
                MinHeight="24"
                MinWidth="0"
                Padding="4,0"
                Margin="0,0,10,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                VerticalAlignment="Center"
                Panel.ZIndex="2"
                Background="Transparent"
                BorderThickness="0"
                Visibility="Collapsed"
                ToolTip="控えを縮小表示で開く"
                AutomationProperties.Name="控えを開く"
                Click="CompactStoredPanelsToggleButton_Click"
                Style="{StaticResource BarButton}">
          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
            <Grid Width="16" Height="16" Margin="0,0,4,0">
              <Ellipse Fill="#F4F7F5" />
              <Path x:Name="CompactStoredPanelsChevron"
                    Width="16" Height="16"
                    Data="M 4,6.5 L 8,10 L 12,6.5"
                    Stroke="#152019"
                    StrokeThickness="1.6"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"
                    RenderTransformOrigin="0.5,0.5" />
            </Grid>
            <TextBlock Text="控え"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" />
          </StackPanel>
      </Button>
      <StackPanel x:Name="AuxiliaryApplicationsRow"
                  Grid.Column="1"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,0,4,0"
                  Panel.ZIndex="2">
        <TextBlock Text="AIアプリ"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Margin="0,0,6,0" />
        <ItemsControl x:Name="AuxiliaryApplicationPanel"
                      ItemsSource="{Binding AuxiliaryApplications}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Margin" Value="3,0,0,0" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type models:LauncherApplication}">
              <Button Content="{Binding ShortName}"
                      Tag="{Binding}"
                      Click="AuxiliaryApplicationButton_Click"
                      Style="{StaticResource AuxiliaryApplicationButtonStyle}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <Border x:Name="CompactStoredPanelsArea"
            Grid.Row="3"
            Visibility="Collapsed"
            Margin="5,2,5,4"
            Padding="5"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="23" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- 控えカードを選んでいる間は、タブの行を配置先の案内と「取消」に置き換える（高さは変えない）。 -->
