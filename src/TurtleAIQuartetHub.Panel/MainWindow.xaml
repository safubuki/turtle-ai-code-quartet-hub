          <Button Content="&#xE70E;"
                  Tag="{Binding}"
                  CommandParameter="-1"
                  Style="{StaticResource SettingsOrderUpButtonStyle}"
                  ToolTip="一つ上へ移動"
                  AutomationProperties.Name="カードを一つ上へ移動"
                  Click="SettingsMovePanelButton_Click" />
          <Button Tag="{Binding}"
                  Cursor="SizeAll"
                  Style="{StaticResource SettingsOrderGripButtonStyle}"
                  ToolTip="ドラッグで移動。ここを選択して ↑ / ↓ キーでも並び替え"
                  AutomationProperties.Name="カードの並び替え（上下キーまたはドラッグ）"
                  PreviewMouseLeftButtonDown="SettingsPanelGrip_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="SettingsPanelGrip_PreviewMouseMove">
            <Grid Width="10" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Ellipse Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,3,3" />
              <Ellipse Grid.Column="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,0,3" />
              <Ellipse Grid.Row="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,3,3" />
              <Ellipse Grid.Row="1" Grid.Column="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,0,3" />
              <Ellipse Grid.Row="2" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,3,0" />
              <Ellipse Grid.Row="2" Grid.Column="1" Width="2.5" Height="2.5" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
