          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="CompactStoredAssignHintText"
                     Margin="2,0,6,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource AccentBrush}"
                     FontSize="12"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="1" Content="取消"
                  Click="CancelCompactStoredAssignButton_Click"
                  Style="{StaticResource BarButton}"
                  Width="38" Height="21" MinHeight="21" MinWidth="0"
                  Padding="2,0" FontSize="11"
                  ToolTip="控えの選択を取り消す（Esc）" />
        </Grid>
        <Grid x:Name="CompactStoredTabsRow">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ItemsControl ItemsSource="{Binding StoredPanelPages}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type models:StoredPanelPage}">
                <Grid>
                  <Button Content="{Binding Header}" Tag="{Binding}"
                          Click="StoredPanelPageTab_Click"
                          MouseDoubleClick="StoredPanelPageTab_MouseDoubleClick"
                          Style="{StaticResource CompactStoredTabStyle}">
                    <Button.ToolTip>
                      <ToolTip Content="{Binding}" Style="{StaticResource StoredPageToolTipStyle}" />
                    </Button.ToolTip>
                  </Button>
                  <TextBox x:Name="PageHeaderEditBox"
                           Tag="{Binding}"
                           Visibility="Collapsed"
                           Text="{Binding Header, Mode=OneWay}"
                           MaxLength="20"
                           Width="50" Height="21"
                           Padding="2,0" FontSize="11"
                           Foreground="{StaticResource TextBrush}"
                           Background="#223027"
                           CaretBrush="{StaticResource TextBrush}"
                           SelectionBrush="{StaticResource AccentBrush}"
                           BorderBrush="{StaticResource AccentBrush}"
                           BorderThickness="1"
                           KeyDown="StoredPanelPageHeaderEditBox_KeyDown"
                           LostFocus="StoredPanelPageHeaderEditBox_LostFocus" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- 標準表示と同じく、整列の横に一覧を置く。 -->
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="整列"
                    Click="CompactStoredPanelsButton_Click"
                    Style="{StaticResource BarButton}"
                    Width="36" Height="21" MinHeight="21" MinWidth="0"
                    Padding="2,0" FontSize="11"
                    ToolTip="控えの空きを前に詰める" />
            <!-- 一覧でカードを選び、本体のスロットの「ここに表示」で配置する（一覧の A〜D パッドは縮小表示では隠す）。 -->
            <Button x:Name="CompactStoredOverviewButton"
                    Width="26"
                    Height="21"
                    MinHeight="21"
                    MinWidth="0"
                    Padding="0"
                    Margin="3,0,0,0"
                    Content="&#xE8A9;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="10"
                    ToolTip="すべての控えを横に一覧表示します。カードを選んでスロットの「ここに表示」を押すか、カードをスロットへドラッグして配置できます。"
                    AutomationProperties.Name="控えの一覧を開く"
                    Click="StoredOverviewButton_Click"
                    Style="{StaticResource StoredOverviewToggleButtonStyle}" />
          </StackPanel>
        </Grid>
        <ContentControl Grid.Row="1"
                        Content="{Binding SelectedStoredPanelPage}"
                        ContentTemplate="{StaticResource CompactStoredPageTemplate}" />
      </Grid>
    </Border>

    <Grid x:Name="FooterControlsGrid" Grid.Row="3" Margin="5,2,5,3">
