    <Style x:Key="StoredPageTabButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#B9C5BE" />
      <Setter Property="Background" Value="#17201B" />
      <Setter Property="BorderBrush" Value="#4A6658" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,0,8,0" />
      <Setter Property="Margin" Value="0,0,5,4" />
      <Setter Property="MinWidth" Value="64" />
      <!-- 名前を変えたタブが長くなっても、6枚が横一列に収まる範囲に抑える。 -->
      <Setter Property="MaxWidth" Value="112" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="AllowDrop" Value="True" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="UseLayoutRounding" Value="True" />
      <EventSetter Event="DragEnter" Handler="StoredPanelTab_DragEnter" />
      <EventSetter Event="DragLeave" Handler="StoredPanelTab_DragLeave" />
      <EventSetter Event="DragOver" Handler="StoredPanelTab_DragOver" />
      <EventSetter Event="Drop" Handler="StoredPanelTab_Drop" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="TabButtonRoot"
                  Height="{TemplateBinding Height}"
                  MinWidth="{TemplateBinding MinWidth}"
                  ClipToBounds="False"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
              <Border x:Name="TabButtonBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="6"
                      SnapsToDevicePixels="True"
                      UseLayoutRounding="True" />
              <!-- 長い名前は「…」で省略する（全文は ToolTip 側で確認できる）。 -->
              <TextBlock Text="{TemplateBinding Content}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="{TemplateBinding Padding}"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="TabButtonBorder" Property="Background" Value="#223027" />
                <Setter TargetName="TabButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabButtonBorder" Property="Background" Value="#243029" />
                <Setter TargetName="TabButtonBorder" Property="BorderBrush" Value="#5E7568" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
