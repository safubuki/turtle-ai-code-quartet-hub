                        BorderThickness="1"
                        CornerRadius="10">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                      <TextBlock Text="&#xEDA2;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="13"
                                 VerticalAlignment="Center"
                                 Margin="0,0,6,0"
                                 Foreground="{StaticResource AccentBrush}" />
                      <TextBlock Text="各ドライブの使用状況"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" />
                    </StackPanel>
                    <ItemsControl x:Name="SystemMonitorDrivesItemsControl">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,6"
                                  Padding="10,8"
                                  Background="#1B221E"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="6,2"
                                        Margin="0,0,8,0"
                                        CornerRadius="5"
                                        Background="#223027"
                                        BorderBrush="#335A43"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding DriveTypeLabel}"
                                             FontSize="10.5"
                                             FontWeight="SemiBold"
                                             Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayTitle}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding UsagePercentText}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0"
                                           Foreground="{Binding BarBrush}" />
                                <Button Grid.Column="3"
                                        Content="&#xE8DA;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="11"
                                        Padding="6,3"
                                        Tag="{Binding RootPath}"
                                        ToolTip="{Binding OpenFolderToolTip}"
                                        Click="SystemMonitorOpenFolderButton_Click"
                                        Style="{StaticResource BaseButton}" />
                              </Grid>
                              <ProgressBar Margin="0,6,0,5"
                                           Style="{StaticResource SystemMonitorProgressBarStyle}"
                                           Foreground="{Binding BarBrush}"
                                           Value="{Binding UsagePercent, Mode=OneWay}" />
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CapacityDetailText}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FreeSpaceText}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                              </Grid>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Margin="0,10,0,0"
                        Padding="12,10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="ディスク整理"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                      </StackPanel>
                      <TextBlock x:Name="DiskCleanupEntrySummaryText"
                                 Margin="0,4,0,0"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="Copilot CLI の旧バージョンと、Temp に残った古いインストーラーを確認します。" />
                    </StackPanel>
                    <Button x:Name="OpenDiskCleanupButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="12,5"
                            VerticalAlignment="Center"
                            Content="確認して整理..."
                            Click="OpenDiskCleanupButton_Click"
                            Style="{StaticResource BaseButton}" />
                  </Grid>
                </Border>

                <Border Margin="0,10,0,0" Padding="12,10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="VS Code の終了・復旧" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                      </StackPanel>
                      <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="更新を妨げている VS Code の残留プロセスを、確認して終了します。" />
                      <TextBlock x:Name="VscodeProcessRecoveryStatusText" Margin="0,4,0,0"
                                 FontSize="11" TextWrapping="Wrap"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="対象は現在のユーザーの VS Code（通常版・Insiders）です。" />
                    </StackPanel>
                    <Button x:Name="OpenVscodeProcessRecoveryButton" Grid.Column="1"
                            Margin="10,0,0,0" Padding="12,5" VerticalAlignment="Center"
                            Content="確認して終了..."
                            AutomationProperties.Name="VS Code の終了対象を確認"
                            Click="OpenVscodeProcessRecoveryButton_Click"
                            Style="{StaticResource BaseButton}" />
                  </Grid>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="12,10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10">
                  <StackPanel>
                    <Grid Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="各フォルダの使用量"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                      </StackPanel>
                      <TextBlock x:Name="SystemMonitorFolderStatusText"
                                 Grid.Column="1"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 Text="" />
                    </Grid>

                    <ItemsControl x:Name="SystemMonitorFoldersItemsControl">
                      <!-- 分類（表 / 控え / アプリ / AI エージェント）ごとに、バッジと同じ色の枠でまとめる。 -->
                      <ItemsControl.GroupStyle>
                        <GroupStyle>
                          <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="GroupItem">
                                    <Border Margin="0,0,0,10"
                                            Padding="0"
                                            CornerRadius="9"
                                            BorderThickness="1"
                                            Background="#141A17"
                                            BorderBrush="{Binding Items[0].BadgeBorderBrush}">
                                      <Expander Tag="{Binding Name}"
                                                Style="{StaticResource SystemMonitorFolderExpanderStyle}"
                                                Loaded="SystemMonitorFolderExpander_Loaded"
                                                Expanded="SystemMonitorFolderExpander_Changed"
                                                Collapsed="SystemMonitorFolderExpander_Changed">
                                        <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                          <Border Width="4"
                                                  Height="14"
                                                  Margin="0,0,7,0"
                                                  CornerRadius="2"
                                                  VerticalAlignment="Center"
                                                  Background="{Binding Items[0].BadgeForegroundBrush}" />
                                          <TextBlock Text="{Binding Name}"
                                                     FontSize="12"
                                                     FontWeight="SemiBold"
                                                     VerticalAlignment="Center"
                                                     Foreground="{Binding Items[0].BadgeForegroundBrush}" />
                                          <TextBlock Text="{Binding ItemCount, StringFormat={}（{0} 件）}"
                                                     FontSize="11"
                                                     Margin="4,0,0,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                        <TextBlock Text="{Binding Items[0].GroupDescriptionText}"
                                                   Margin="13,10,0,10"
                                                   FontSize="10.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                        <ItemsPresenter />
                                        </StackPanel>
                                      </Expander>
                                    </Border>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </GroupStyle.ContainerStyle>
                        </GroupStyle>
                      </ItemsControl.GroupStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,0,6"
                                  Padding="10,8"
                                  Background="#1B221E"
                                  BorderBrush="{StaticResource BorderBrushSoft}"
                                  BorderThickness="1"
                                  CornerRadius="8">
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border MinWidth="36"
                                        Padding="6,2"
                                        Margin="0,0,8,0"
                                        CornerRadius="5"
                                        Background="{Binding BadgeBackgroundBrush}"
                                        BorderBrush="{Binding BadgeBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                  <TextBlock Text="{Binding BadgeText}"
                                             FontSize="10.5"
                                             FontWeight="SemiBold"
                                             HorizontalAlignment="Center"
                                             Foreground="{Binding BadgeForegroundBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SubDetailText}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SizeText}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{StaticResource AccentBrush}" />
                                <!-- Hub・VS Code・Antigravity のデータだけ、容量の内訳と原因を解析できる。 -->
                                <Button Grid.Column="4"
                                        Content="&#xE721;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="11"
                                        Padding="6,3"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        ToolTip="容量の内訳と、増えた原因を解析"
                                        AutomationProperties.Name="容量の内訳と原因を解析"
                                        Click="AnalyzeDataFolderButton_Click">
                                  <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                      <Setter Property="Visibility" Value="Collapsed" />
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanAnalyze}" Value="True">
                                          <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                                <Button Grid.Column="5"
                                        Content="&#xE8DA;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="11"
                                        Padding="6,3"
                                        Tag="{Binding FolderPath}"
                                        IsEnabled="{Binding CanOpenFolder}"
                                        ToolTip="{Binding OpenFolderToolTip}"
                                        Click="SystemMonitorOpenFolderButton_Click"
                                        Style="{StaticResource BaseButton}" />
                              </Grid>
                              <ProgressBar Margin="0,6,0,5"
                                           Height="5"
                                           Style="{StaticResource SystemMonitorProgressBarStyle}"
                                           Foreground="{Binding BarBrush}"
                                           Value="{Binding UsageRatio, Mode=OneWay}" />
                              <TextBlock Text="{Binding DisplayPath}"
                                         FontSize="10.5"
                                         TextTrimming="CharacterEllipsis"
                                         ToolTip="{Binding DisplayPath}"
                                         Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2"
                  Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center"
                         FontSize="11"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="※ メモリ・CPU・ドライブは1.5秒ごとに自動更新されます" />
              <Button x:Name="CloseSystemMonitorDialogButton"
                      Grid.Column="1"
                      Content="閉じる"
                      Click="CloseSystemMonitorButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="88" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Border x:Name="DiskCleanupOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="24">
      <Grid>
        <Border Width="590"
                MaxHeight="490"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE74D;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="15"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Text="ディスク整理"
                             FontSize="16"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <TextBlock x:Name="DiskCleanupStatusText"
                           Margin="0,2,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="削除できる候補を確認しています..." />
              </StackPanel>
              <Button x:Name="RescanDiskCleanupButton"
                      Grid.Column="1"
                      Content="再スキャン"
                      Click="RescanDiskCleanupButton_Click"
                      Style="{StaticResource BaseButton}"
                      Padding="10,4"
                      Margin="0,0,8,0"
                      VerticalAlignment="Top" />
              <Button Grid.Column="2"
                      ToolTip="ディスク整理を閉じる"
                      AutomationProperties.Name="ディスク整理を閉じる"
                      Click="CloseDiskCleanupButton_Click"
                      Style="{StaticResource ModalCloseButtonStyle}"
                      VerticalAlignment="Top" />
            </Grid>

            <!-- 安全度の凡例。削除してよいかを色で判断できるようにする。 -->
            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="10,7"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Border Padding="6,1" CornerRadius="5" BorderThickness="1" Background="#16301F" BorderBrush="#2F7A4C" VerticalAlignment="Top" Margin="0,0,6,0">
                    <TextBlock Text="安全" FontSize="10.5" FontWeight="SemiBold" Foreground="#6FE3A0" />
                  </Border>
                  <TextBlock Text="再取得できる&#x0a;不要ファイル" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Border Padding="6,1" CornerRadius="5" BorderThickness="1" Background="#332A12" BorderBrush="#8A7230" VerticalAlignment="Top" Margin="0,0,6,0">
                    <TextBlock Text="注意" FontSize="10.5" FontWeight="SemiBold" Foreground="#F2CA57" />
                  </Border>
                  <TextBlock Text="24時間以内に作成。&#x0a;既定では選択しない" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <Border Padding="6,1" CornerRadius="5" BorderThickness="1" Background="#23292A" BorderBrush="#465052" VerticalAlignment="Top" Margin="0,0,6,0">
                    <TextBlock Text="保持" FontSize="10.5" FontWeight="SemiBold" Foreground="#A9B4B6" />
                  </Border>
                  <TextBlock Text="最新版・使用中。&#x0a;削除できません" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,4,0">
                <Border Padding="12,10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="GitHub Copilot CLI の旧バージョン"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" />
                      <TextBlock x:Name="DiskCleanupCopilotSummaryText"
                                 Grid.Column="1"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <TextBlock x:Name="DiskCleanupCopilotNoteText"
                               Margin="0,4,0,8"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="自動更新のたびに約 200 MB の旧版が %USERPROFILE%\.copilot\pkg に残ります。最新版は残し、設定やセッション履歴には触れません。" />
                    <ItemsControl x:Name="DiskCleanupCopilotItemsControl"
                                  ItemTemplate="{StaticResource DiskCleanupCandidateTemplate}" />
                  </StackPanel>
                </Border>

                <Border Margin="0,10,0,0"
                        Padding="12,10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Temp に残ったインストーラー・更新ファイル"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" />
                      <TextBlock x:Name="DiskCleanupTempSummaryText"
                                 Grid.Column="1"
                                 FontSize="11"
                                 VerticalAlignment="Center"
                                 Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <TextBlock x:Name="DiskCleanupTempNoteText"
                               Margin="0,4,0,8"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Temp 直下にある、インストーラー（.exe / .msi / .msix など 10 MB 以上）か、インストーラーだけが入ったフォルダが対象です。その他の一時ファイルには触れません。" />
                    <ItemsControl x:Name="DiskCleanupTempItemsControl"
                                  ItemTemplate="{StaticResource DiskCleanupCandidateTemplate}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3"
                  Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="DiskCleanupSelectionText"
                         VerticalAlignment="Center"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}"
                         Text="選択中: 0 件" />
              <Button x:Name="CloseDiskCleanupDialogButton"
                      Grid.Column="1"
                      Content="閉じる"
                      Click="CloseDiskCleanupButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="88"
                      Margin="0,0,8,0" />
              <Button x:Name="DeleteDiskCleanupButton"
                      Grid.Column="2"
                      Content="選択した項目を削除..."
                      IsEnabled="False"
                      Click="DeleteDiskCleanupButton_Click"
                      Style="{StaticResource DangerButtonStyle}" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- 容量の解析結果。結論 → 伝えるときのキーワード → 現象・原因・対処 → 容量の多い場所 の順に並べる。
         キーワード（H1・V3 など）の意味は docs/guides/data-folder-diagnostics.md と対応する。 -->
    <Border x:Name="DataFolderAnalysisOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="24">
      <Grid>
        <Border Width="590"
                MaxHeight="520"
                Padding="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE721;"
                             FontFamily="Segoe MDL2 Assets"
                             FontSize="15"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             Foreground="{StaticResource AccentBrush}" />
                  <TextBlock x:Name="DataFolderAnalysisTitleText"
                             Text="容量の解析"
                             FontSize="16"
                             FontWeight="Bold"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <TextBlock x:Name="DataFolderAnalysisStatusText"
                           Margin="0,2,0,0"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
              </StackPanel>
              <Button x:Name="RerunDataFolderAnalysisButton"
                      Grid.Column="1"
                      Content="再解析"
                      Click="RerunDataFolderAnalysisButton_Click"
                      Style="{StaticResource BaseButton}"
                      Padding="10,4"
                      Margin="0,0,8,0"
                      VerticalAlignment="Top" />
              <Button Grid.Column="2"
                      ToolTip="解析を閉じる"
                      AutomationProperties.Name="解析を閉じる"
                      Click="CloseDataFolderAnalysisButton_Click"
                      Style="{StaticResource ModalCloseButtonStyle}"
                      VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,10,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="DataFolderAnalysisResultPanel" Margin="0,0,4,0" Visibility="Collapsed">
                <!-- 結論。枠の色で 正常（緑）・注意（黄）・要対処（赤）を示す。 -->
                <Border x:Name="DataFolderAnalysisConclusionBorder"
                        Padding="12,10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderThickness="1.5"
                        CornerRadius="10">
                  <StackPanel>
                    <TextBlock x:Name="DataFolderAnalysisConclusionText"
                               FontSize="15"
                               FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DataFolderAnalysisTotalText"
                               Margin="0,3,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Border Margin="0,9,0,0"
                            Padding="10,7"
                            Background="#141A17"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="8">
                      <StackPanel>
                        <TextBlock Text="伝えるときのキーワード"
                                   FontSize="10.5"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox x:Name="DataFolderAnalysisKeywordText"
                                 Margin="0,2,0,0"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 CaretBrush="{StaticResource TextBrush}"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="記号（H1・V3 など）と大きさを伝えると、原因と改善策を特定できます。" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <ItemsControl x:Name="DataFolderAnalysisFindingsItemsControl" Margin="0,10,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:DataFolderFinding}">
                      <Border Margin="0,0,0,8"
                              Padding="12,9"
                              Background="#1B221E"
                              BorderBrush="{Binding LevelBrush}"
                              BorderThickness="3,1,1,1"
                              CornerRadius="8">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="7,1"
                                    Margin="0,0,6,0"
                                    CornerRadius="5"
                                    Background="#223027"
                                    BorderBrush="{Binding LevelBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding Code}"
                                         FontSize="12"
                                         FontWeight="Bold"
                                         Foreground="{StaticResource TextBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LevelText}"
                                       Margin="0,0,8,0"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding LevelBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SizeText}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding LevelBrush}" />
                          </Grid>
                          <TextBlock Margin="0,6,0,0"
                                     Text="{Binding Symptom}"
                                     FontSize="12"
                                     FontWeight="SemiBold"
                                     TextWrapping="Wrap"
                                     Foreground="{StaticResource TextBrush}" />
                          <TextBlock Margin="0,5,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="原因: " FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="{Binding Cause, Mode=OneWay}" />
                          </TextBlock>
                          <TextBlock Margin="0,3,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="対処: " FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" /><Run Text="{Binding Remedy, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,2,0,0"
                        Padding="12,10"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="10">
                  <StackPanel>
                    <TextBlock Text="容量の多い場所（上位）"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <ItemsControl x:Name="DataFolderAnalysisHeavyItemsControl" Margin="0,6,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DataFolderHeavyEntry}">
                          <StackPanel Margin="0,0,0,7">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Label}"
                                         FontSize="11.5"
                                         FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="{StaticResource TextBrush}" />
                              <TextBlock Grid.Column="1"
                                         Text="{Binding PercentText}"
                                         Margin="8,0,8,0"
                                         FontSize="11"
                                         Foreground="{StaticResource MutedTextBrush}" />
                              <TextBlock Grid.Column="2"
                                         Text="{Binding SizeText}"
                                         FontSize="12"
                                         FontWeight="Bold"
                                         Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <ProgressBar Margin="0,3,0,2"
                                         Height="4"
                                         Style="{StaticResource SystemMonitorProgressBarStyle}"
                                         Foreground="{StaticResource AccentBrush}"
                                         Value="{Binding Percent, Mode=OneWay}" />
                            <TextBlock Text="{Binding RelativePath}"
                                       FontSize="10.5"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RelativePath}"
                                       Foreground="{StaticResource MutedTextBrush}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center"
                         FontSize="11"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="※ 解析は読み取りだけで、ファイルを削除・変更しません。" />
              <Button x:Name="CloseDataFolderAnalysisDialogButton"
                      Grid.Column="1"
                      Content="閉じる"
                      Click="CloseDataFolderAnalysisButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="88" />
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="VscodeProcessRecoveryConfirmOverlay" Grid.RowSpan="5"
            Visibility="Collapsed" Background="#96090B0A" Panel.ZIndex="27"
            KeyboardNavigation.TabNavigation="Cycle">
      <Grid>
        <Border Width="550" MaxHeight="440" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="14">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="VscodeProcessRecoveryConfirmTitleText" Text="VS Code を強制終了しますか？" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <StackPanel Grid.Row="1" Margin="0,8,0,12">
              <TextBlock x:Name="VscodeProcessRecoveryConfirmMessageText" TextWrapping="Wrap"
                         Foreground="{StaticResource TextBrush}" />
              <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                         Foreground="{StaticResource MutedTextBrush}"
                         Text="ハブ外で開いている VS Code と、バックグラウンドの VS Code も対象になります。" />
            </StackPanel>
            <Border Grid.Row="2" Padding="10,8" Background="#141A17"
                    BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="140">
                <StackPanel>
                <TextBlock x:Name="VscodeProcessRecoveryConfirmDetailText" FontSize="11"
                           TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="VscodeProcessRecoveryConfirmIssuesText" Margin="0,8,0,0"
                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
              <TextBlock x:Name="VscodeProcessRecoveryWarningText" Text="未保存の編集が失われたり、ターミナルや AI の処理が中断したりする可能性があります。必要な作業を保存してから実行してください。"
                         TextWrapping="Wrap" Foreground="#F2B7AF" />
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="CancelVscodeProcessRecoveryButton" Content="キャンセル"
                      MinWidth="96" Margin="0,0,8,0" Style="{StaticResource BaseButton}"
                      Click="CancelVscodeProcessRecoveryButton_Click" />
              <Button x:Name="ConfirmVscodeProcessRecoveryButton" Content="強制終了する"
                      IsEnabled="False" Style="{StaticResource DangerButtonStyle}"
                      Click="ConfirmVscodeProcessRecoveryButton_Click" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="DiskCleanupConfirmOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="26">
      <Grid>
        <Border Width="420"
                Padding="16"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#8C3F38"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="34"
                      Height="34"
                      CornerRadius="10"
                      Background="#2B1715"
                      BorderBrush="#8C3F38"
                      BorderThickness="1"
                      Margin="0,0,12,0">
                <TextBlock Text="&#xE74D;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="16"
                           Foreground="#F2B7AF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="選択した項目を削除しますか？"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="DiskCleanupConfirmMessageText"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,14,0,0"
                    Padding="10,8"
                    MaxHeight="150"
                    Background="#271A18"
                    BorderBrush="#8C3F38"
                    BorderThickness="1"
                    CornerRadius="8">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DiskCleanupConfirmDetailText"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
              </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="2"
                       Margin="0,12,0,0"
                       Text="ごみ箱には移動せず、すぐに削除して容量を空けます。必要になれば各アプリが再ダウンロードします。設定・履歴・サインイン情報は対象外です。使用中の項目は自動でスキップします。"
                       Foreground="#F2B7AF"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="3"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
              <Button x:Name="CancelDiskCleanupConfirmButton"
                      Content="キャンセル"
                      Click="CancelDiskCleanupConfirmButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="96"
                      Margin="0,0,8,0" />
              <Button x:Name="ConfirmDiskCleanupButton"
                      Content="削除する"
                      Click="ConfirmDiskCleanupButton_Click"
                      Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
