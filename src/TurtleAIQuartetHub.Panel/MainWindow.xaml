    <Style x:Key="MicroCenterButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#101714" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- 円形ボタン: 直径 22 → CornerRadius 11 で完全な円。
                 ContentPresenter は下げ気味の補正で大文字 1 字を視覚的中央に置く。 -->
            <Border x:Name="MicroCenterBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                <ContentPresenter.RenderTransform>
                  <TranslateTransform Y="-1" />
                </ContentPresenter.RenderTransform>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MicroCenterBorder" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                <Setter Property="Foreground" Value="#D8FFE6" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MicroCenterBorder" Property="Background" Value="#0A1A11" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 非表示中の円形トグル(縮小/極小モード)。標準モードの「表示」ボタンと同じ黄色にして、
         どのモードでも「今は隠している＝押せば戻る」が一目で分かるようにする。
         配色は VisibilityRestoreButtonStyle と揃える。形状・サイズは緑版と同一。 -->
    <Style x:Key="MicroCenterRestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource MicroCenterButtonStyle}">
      <Setter Property="Background" Value="#F2CA57" />
      <Setter Property="BorderBrush" Value="#FFF0B5" />
      <Setter Property="Foreground" Value="#1A1406" />
      <!-- 緑版のテンプレートはホバー/押下で Border の Background を名前指定で上書きするため、
           Style 側の Setter では勝てない。テンプレートごと差し替えて黄色系の反応にする。 -->
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="MicroCenterRestoreBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                <ContentPresenter.RenderTransform>
                  <TranslateTransform Y="-1" />
                </ContentPresenter.RenderTransform>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MicroCenterRestoreBorder" Property="Background" Value="#F7DA83" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MicroCenterRestoreBorder" Property="Background" Value="#D9AF3C" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="MicroSlotButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="MicroFocusFrame"
                    Background="Transparent"
                    BorderBrush="{Binding FocusFrameBrush}"
                    BorderThickness="2"
                    CornerRadius="7">
              <Grid>
                <Border CornerRadius="7"
                        Style="{StaticResource AiCardHaloStyle}" />
                <Border x:Name="MicroButtonBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                  <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                </Border>
                <Border CornerRadius="6"
                        Style="{StaticResource AiCardPulseStyle}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MicroButtonBorder" Property="Background" Value="#1A211D" />
                <Setter TargetName="MicroButtonBorder" Property="BorderBrush" Value="#3D4E45" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MicroButtonBorder" Property="Background" Value="#121715" />
              </Trigger>
              <DataTrigger Binding="{Binding IsFocused}" Value="True">
                <Setter TargetName="MicroButtonBorder" Property="Background" Value="#123222" />
                <Setter TargetName="MicroButtonBorder" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#45D483"
                                      BlurRadius="9"
                                      ShadowDepth="0"
                                      Opacity="0.4" />
                  </Setter.Value>
                </Setter>
              </DataTrigger>
              <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Working}">
                <Setter TargetName="MicroButtonBorder" Property="Effect" Value="{x:Null}" />
              </DataTrigger>
              <!-- 完了はボタン全体を少し濃いめの青で点灯させ、外枠と外側の光背を AiCardPulseStyle / AiCardHaloStyle で揃える。 -->
              <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Done}">
                <Setter TargetName="MicroButtonBorder" Property="Background" Value="{StaticResource AiDoneBadgeBackgroundBrush}" />
                <Setter TargetName="MicroButtonBorder" Property="Effect" Value="{x:Null}" />
              </DataTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Missing}">
          <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
          <Setter Property="BorderBrush" Value="#505B55" />
          <Setter Property="Foreground" Value="#6F7B74" />
        </DataTrigger>
        <DataTrigger Binding="{Binding WindowStatus}" Value="{x:Static models:SlotWindowStatus.Launching}">
          <Setter Property="Background" Value="#241F15" />
          <Setter Property="BorderBrush" Value="#A27E39" />
          <Setter Property="Foreground" Value="#F2CA57" />
        </DataTrigger>
        <DataTrigger Binding="{Binding AiActivity}" Value="{x:Static models:AiActivityState.Done}">
          <Setter Property="Foreground" Value="{StaticResource AiDoneBadgeForegroundBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CompactStatusDotStyle" TargetType="Ellipse">
      <Setter Property="Width" Value="5" />
      <Setter Property="Height" Value="5" />
