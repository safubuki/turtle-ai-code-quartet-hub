                    CornerRadius="8">
              <StackPanel>
                <TextBlock x:Name="DeleteStoredPanelDetailText"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="DeleteStoredPanelPathText"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
              <TextBlock Text="クリアすると、この控えスロットは空きになります。"
                         Foreground="{StaticResource MutedTextBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,6,0,0"
                         Text="※ フォルダやファイル本体は削除されません。"
                         Foreground="{StaticResource AccentBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Margin="0,16,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
              <Button x:Name="CancelDeleteStoredPanelButton"
                      Content="キャンセル"
                      Click="CancelDeleteStoredPanelButton_Click"
                      Style="{StaticResource BaseButton}"
                      MinWidth="96"
                      Margin="0,0,8,0" />
              <Button x:Name="ConfirmDeleteStoredPanelButton"
                      Content="クリアする"
                      Click="ConfirmDeleteStoredPanelButton_Click"
                      Style="{StaticResource DangerButtonStyle}" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="SettingsOverlay"
            Grid.RowSpan="5"
            Visibility="Collapsed"
            Background="#96090B0A"
            Panel.ZIndex="22">
      <Grid>
        <Border MaxWidth="610"
                MaxHeight="560"
                Margin="14"
                Padding="16"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="12"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
          <Grid MaxHeight="{Binding Height, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource SubtractConverter}, ConverterParameter=78}">
            <Grid x:Name="SettingsMainContentGrid">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="設定"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock x:Name="SettingsConfigPathText"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      ToolTip="閉じる"
                      AutomationProperties.Name="設定を閉じる"
                      Click="CloseSettingsButton_Click"
                      Style="{StaticResource ModalCloseButtonStyle}" />
            </Grid>

            <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1"
                          Margin="0,12,0,0"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <Border Padding="10"
                        Margin="0,0,0,12"
                        Background="#111815"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                      <TextBlock Text="スロットと控え"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}" />
                      <TextBlock Margin="0,3,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource MutedTextBrush}"
                                 TextWrapping="Wrap"
                                 Text="タイトル、ワークスペース、選択アプリを保存ファイルへ書き込みます。起動コマンドのパスは、下の「パス設定を保存」です。" />
                      <TextBlock x:Name="PanelStateActionStatusText"
                                 Margin="0,3,0,0"
                                 FontSize="11"
                                 Foreground="{StaticResource AccentBrush}"
                                 TextWrapping="Wrap"
                                 Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="SaveSettingsButton"
                              Content="設定を保存"
                              MinWidth="124"
                              Margin="0,0,8,0"
                              Click="SaveSettingsButton_Click"
                              Style="{StaticResource BaseButton}"
                              ToolTip="いまのスロットと控えを保存ファイルへ書き込みます" />
                      <Button x:Name="LoadSettingsButton"
                              Content="設定を読み込み"
                              MinWidth="140"
                              Click="LoadSettingsButton_Click"
                              Style="{StaticResource BaseButton}"
                              ToolTip="保存ファイルのスロットと控えを画面へ戻します" />
                    </StackPanel>
                  </Grid>
                </Border>

                <Border Padding="10"
                        Margin="0,0,0,12"
                        Background="#111815"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="AI の作業通知"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,4,0,8"
                               Text="AI の作業中・完了を、スロットのカードと A〜D アイコンでお知らせします。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl x:Name="AiNotifyHookLocationsItemsControl">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Padding="0,6" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="•" Margin="0,0,6,0" Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" Margin="8,0,0,0"
                                           ToolTip="{Binding StatusDetailToolTip}" Foreground="{StaticResource MutedTextBrush}" />
                              </StackPanel>
                              <Button Grid.Column="1" Grid.RowSpan="2" Margin="8,0,0,0" Padding="8,4" FontSize="11"
                                      VerticalAlignment="Center" Content="フォルダ"
                                      Tag="{Binding}" IsEnabled="{Binding CanOpenFolder}"
                                      ToolTip="{Binding FolderToolTip}"
                                      ToolTipService.ShowOnDisabled="True"
                                      AutomationProperties.Name="{Binding DisplayName, StringFormat={}{0} の設定フォルダを開く}"
                                      Click="AiNotifySettingsFolderButton_Click" Style="{StaticResource BaseButton}" />
                              <Button Grid.Column="2" Grid.RowSpan="2" Margin="6,0,0,0" Padding="8,4" FontSize="11"
                                      VerticalAlignment="Center" Content="設定を見る"
                                      Tag="{Binding}" IsEnabled="{Binding CanViewSettings}"
                                      ToolTip="{Binding SettingsToolTip}"
                                      ToolTipService.ShowOnDisabled="True"
                                      AutomationProperties.Name="{Binding DisplayName, StringFormat={}{0} のフック設定を見る}"
                                      Click="AiNotifyViewSettingsButton_Click" Style="{StaticResource BaseButton}" />
                              <TextBlock Grid.Row="1" Text="{Binding DisplayPath}" FontSize="10.5" Margin="12,3,0,0"
                                         TextTrimming="CharacterEllipsis" ToolTip="{Binding SettingsPath}"
                                         Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,7,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                               Text="Codex：初回は CLI の /hooks で承認してください。Grok・Antigravity：設定のあと、開いているセッションやウィンドウを開き直してください。" TextWrapping="Wrap" />
                    <TextBlock x:Name="AiNotifyActionStatusText" Margin="0,6,0,0" Visibility="Collapsed"
                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                      <Button Content="フックを設定"
                              MinWidth="110"
                              Click="InstallAiNotifyHooksButton_Click"
                              Style="{StaticResource BaseButton}"
                              ToolTip="インストール済みのツールにだけ、通知用のフックを追加（設定し直しても重複しません）" />
                      <Button Content="フックを解除"
                              MinWidth="110"
                              Margin="8,0,0,0"
                              Click="UninstallAiNotifyHooksButton_Click"
                              Style="{StaticResource BaseButton}"
                              ToolTip="このアプリが追加した通知用のフックだけを取り除く（ほかの設定は残す）" />
                      <Button x:Name="OpenAiHookGuideButton" Content="仕組みを見る" MinWidth="110"
                              Margin="8,0,0,0" Click="OpenAiHookGuideButton_Click"
                              Style="{StaticResource BaseButton}"
                              ToolTip="通知の流れと、設定・解除で変わる内容を図で確認" />
                    </StackPanel>
                    <Expander x:Name="AiNotifyDetailsExpander" Header="通知の見方・補足" IsExpanded="False"
                              Tag="通知の見方と補足" Style="{StaticResource SystemMonitorFolderExpanderStyle}"
                              Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                      <StackPanel Margin="16,5,0,0">
                        <TextBlock Text="• 作業中：カードの細い枠がゆっくり緑に明滅し、枠の外がぼんやり光ります（許可の確認中も同じ）。完了したときだけ、枠が薄い青になり、ボタンと IDE / CLI の中を除いてカードが薄く青くなります。" TextWrapping="Wrap" />
                        <TextBlock Text="• 光は、そのスロットのフォーカス表示を切り替えると消えます。" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="• VS Code や Antigravity のチャットと CLI の両方が対象です。" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="• 既存設定の保持やバックアップの扱いは「仕組みを見る」で確認できます。" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="• パスの ~ はユーザーのホームフォルダです。完全なパスは行にマウスを合わせると確認できます。" Margin="0,3,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>

                <Border Padding="10"
                        Background="#111815"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="VS Code 共通ユーザー設定"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,4,0,8"
                               Text="通常は VS Code の共通ユーザー設定を使います。専用プロファイルでは、その窓で保存したプロキシの有効・無効を再起動後も保持します。ここで全パネルへ適用すると専用プロファイルのプロキシ設定を更新します。通常の VS Code で保存した設定は、このアプリから書き換えません。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                      <Button Content="オープンネットワーク"
                              Margin="0,0,4,0"
                              Click="SelectOpenNetworkButton_Click"
                              Style="{StaticResource SettingsOpenNetworkButtonStyle}"
                              ToolTip="http.proxy を空にし、環境変数のプロキシも使わない" />
                      <Button Content="プロキシ環境"
                              Margin="4,0,0,0"
                              Click="SelectProxyNetworkButton_Click"
                              Style="{StaticResource SettingsProxyNetworkButtonStyle}"
                              ToolTip="入力したプロキシ URL を全パネルの User/settings.json へ書く" />
                    </UniformGrid>
                    <TextBlock Text="プロキシ URL"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" />
                    <TextBox Margin="0,4,0,8"
                             Text="{Binding VsCodeHttpProxy, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding VsCodeProxyFieldsEnabled}"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             ToolTip="例: http://proxy.example.local:8080" />
                    <TextBlock Text="例外 (noProxy)"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10" />
                    <TextBox Margin="0,4,0,8"
                             Text="{Binding VsCodeHttpNoProxy, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding VsCodeProxyFieldsEnabled}"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             ToolTip="カンマ区切り。例: localhost,127.0.0.1" />
                    <Button Content="全パネルへ適用"
                            HorizontalAlignment="Left"
                            MinWidth="122"
                            Click="ApplyVsCodeNetworkSettingsButton_Click"
                            Style="{StaticResource BaseButton}"
                            ToolTip="ハブ設定へ保存し、専用プロファイルがある場合だけその settings.json へ書きます。標準の VS Code settings.json は変更しません" />
                  </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="10"
                        Background="#111815"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="アプリケーションパス"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,4,0,8"
                               Text="空欄は自動検出を使います。パスが変わった場合は exe/cmd/lnk またはコマンド名を指定してください。"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ApplicationPathSettings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ApplicationPathSetting}">
                          <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="92" />
                              <ColumnDefinition Width="58" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding ShortName}"
                                       Foreground="{StaticResource TextBrush}"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding KindText}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding ToolTip}"
                                     Style="{StaticResource SettingsTextBoxStyle}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Margin="0,2,0,0"
                                       Text="{Binding ResolvedCommand}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="10"
                        Background="#111815"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="表の Quartet"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="↑↓ボタン・つまみの上下キー・ドラッグで並び替え（カードへ即時反映・自動保存）"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <ItemsControl Margin="0,8,0,0"
                                  ItemsSource="{Binding Slots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:WindowSlot}">
                          <Border Margin="0,0,0,8"
                                  Tag="{Binding}" AllowDrop="True"
                                  DragEnter="SettingsPanelRow_DragOver" DragOver="SettingsPanelRow_DragOver"
                                  DragLeave="SettingsPanelRow_DragLeave" Drop="SettingsPanelRow_Drop"
                                  Padding="8"
                                  Background="#151D19"
                                  BorderBrush="#2A3A31"
                                  BorderThickness="1"
                                  CornerRadius="7">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <ContentControl Grid.RowSpan="4" Content="{Binding}" ContentTemplate="{StaticResource SettingsPanelOrderTemplate}" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}"
                                         Foreground="{StaticResource AccentBrush}"
                                         FontWeight="SemiBold" />
                              <TextBox Grid.Column="2"
                                       Text="{Binding ApplicationId, UpdateSourceTrigger=LostFocus}"
                                       ToolTip="vscode / antigravity / codex / claude / github-copilot / grok / antigravity-cli"
                                       Style="{StaticResource SettingsTextBoxStyle}" />
                              <Button Grid.Column="3"
                                      Content="空にする"
                                      Tag="{Binding}"
                                      Click="SettingsClearVisibleSlotButton_Click"
                                      Style="{StaticResource StoredAssignButton}"
                                      Margin="8,0,0,0" />

                              <TextBlock Grid.Row="1" Grid.Column="1"
                                         Text="名前"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="1"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding PanelTitle, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />

                              <TextBlock Grid.Row="2" Grid.Column="1"
                                         Text="パス"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="2"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Path, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />

                              <TextBlock Grid.Row="3" Grid.Column="1"
                                         Text="保存済"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <Grid Grid.Row="3"
                                    Grid.Column="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SavedWorkspacePath, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource SettingsTextBoxStyle}" />
                                <CheckBox Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding SavedWorkspaceConfirmed}"
                                          Foreground="{StaticResource MutedTextBrush}"
                                          Content="再利用" />
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="10"
                        Background="#111815"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="控えタブの名前"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="タブをダブルクリックしても変更できます。空欄にすると既定名に戻ります。"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <ItemsControl Margin="0,8,0,0"
                                  ItemsSource="{Binding StoredPanelPages}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:StoredPanelPage}">
                          <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="58" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding DefaultHeader}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                            <TextBox Grid.Column="1"
                                     Tag="{Binding}"
                                     Text="{Binding CustomHeader, UpdateSourceTrigger=LostFocus}"
                                     MaxLength="20"
                                     ToolTip="空欄にすると既定名に戻ります"
                                     LostFocus="SettingsStoredPageHeaderTextBox_LostFocus"
                                     Style="{StaticResource SettingsTextBoxStyle}" />
                            <Button Grid.Column="2"
                                    Content="既定に戻す"
                                    Tag="{Binding}"
                                    Click="SettingsResetStoredPageHeaderButton_Click"
                                    IsEnabled="{Binding HasCustomHeader}"
                                    ToolTip="この控えの名前だけを既定に戻します"
                                    Style="{StaticResource StoredAssignButton}"
                                    Margin="8,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="10"
                        Background="#111815"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel>
                    <TextBlock Text="控え Quartet"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="↑↓ボタン・つまみの上下キー・ドラッグで並び替え（ページをまたいで移動できます）"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <ItemsControl Margin="0,8,0,0"
                                  ItemsSource="{Binding StoredPanels}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:StoredPanelSlot}">
                          <Border Margin="0,0,0,8"
                                  Tag="{Binding}" AllowDrop="True"
                                  DragEnter="SettingsPanelRow_DragOver" DragOver="SettingsPanelRow_DragOver"
                                  DragLeave="SettingsPanelRow_DragLeave" Drop="SettingsPanelRow_Drop"
                                  Padding="8"
                                  Background="#151D19"
                                  BorderBrush="#2A3A31"
                                  BorderThickness="1"
                                  CornerRadius="7">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>

                              <ContentControl Grid.RowSpan="3" Content="{Binding}" ContentTemplate="{StaticResource SettingsPanelOrderTemplate}" />
                              <TextBlock Grid.Column="1" Text="{Binding Label}"
                                         Foreground="{StaticResource AccentBrush}"
                                         FontWeight="SemiBold" />
                              <TextBox Grid.Column="2"
                                       Text="{Binding ApplicationId, UpdateSourceTrigger=LostFocus}"
                                       ToolTip="vscode / antigravity / codex / claude / github-copilot / grok / antigravity-cli"
                                       Style="{StaticResource SettingsTextBoxStyle}" />
                              <Button Grid.Column="3"
                                      Content="空にする"
                                      Tag="{Binding}"
                                      Click="SettingsClearStoredPanelButton_Click"
                                      Style="{StaticResource StoredAssignButton}"
                                      Margin="8,0,0,0" />

                              <TextBlock Grid.Row="1" Grid.Column="1"
                                         Text="名前"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="1"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding PanelTitle, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />

                              <TextBlock Grid.Row="2" Grid.Column="1"
                                         Text="パス"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         FontSize="10" />
                              <TextBox Grid.Row="2"
                                       Grid.Column="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding WorkspacePath, UpdateSourceTrigger=LostFocus}"
                                       Style="{StaticResource SettingsTextBoxStyle}"
                                       Margin="0,4,0,0" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
